/* app.wxss - 极简现代风格 */

page {
  --primary: #667eea;
  --primary-dark: #5a67d8;
  --accent: #f093fb;
  --accent-alt: #4facfe;
  --success: #00d9ff;
  --warning: #ffc107;
  
  --bg: #0f0f23;
  --bg-light: #1a1a2e;
  --bg-card: #252542;
  --card: rgba(255,255,255,0.04);
  --card-hover: rgba(255,255,255,0.08);
  --border: rgba(255,255,255,0.08);
  --border-light: rgba(255,255,255,0.15);
  
  --text: #ffffff;
  --text-secondary: rgba(255,255,255,0.7);
  --text-muted: rgba(255,255,255,0.5);
  
  --radius: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow: 0 8rpx 32rpx rgba(0,0,0,0.5);
  --glow: 0 0 40rpx rgba(102,126,234,0.4);
  
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 渐变按钮 */
.gradient-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: var(--radius-md);
  letter-spacing: 2rpx;
}

/* 霓发光 */
.neon-glow {
  box-shadow: var(--glow), inset 0 0 20rpx rgba(102,126,234,0.1);
}

/* 玻璃卡片 */
.glass-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
}

/* 标签 */
.tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(102,126,234,0.15);
  color: var(--primary);
  letter-spacing: 1rpx;
}

.tag-accent {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  color: #fff;
}

/* 动画 */
.fade-up {
  animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.scale-in {
  animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-light) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton 1.2s infinite linear;
}

@keyframes skeleton {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* app.wxss - 全局样式 */

/* 引入字体图标 */
@import './styles/iconfont.wxss';

/* 全局变量 */
page {
  --primary-color: #FF6B6B;
  --secondary-color: #FFE66D;
  --bg-color: #FFF5F5;
  --text-color: #333333;
  --text-light: #666666;
  --card-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.15);
  
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-color);
  min-height: 100vh;
}

/* 卡片通用样式 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: var(--card-shadow);
  transition: all 0.3s ease;
}

.card:active {
  transform: scale(0.98);
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
}

/* 副标题 */
.subtitle {
  font-size: 26rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

/* 渐变按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.btn-primary::after {
  border: none;
}

/* 加载动画 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--text-light);
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
<!--pages/index/index.wxml-->
<view class="page-wrapper {{pageClass}}">
  <!-- 顶部 -->
  <view class="header">
    <view class="brand">
      <view class="brand-dot"></view>
      <text class="brand-name">哇哇笑</text>
    </view>
    
    <view class="header-right">
      <view class="theme-btn glass btn-press" bindtap="toggleTheme">
        <text class="theme-icon">{{themeIcon}}</text>
      </view>
      <view class="search-btn glass btn-press" bindtap="goToSearch">
        <text class="search-icon">🔍</text>
      </view>
      <view class="submit-btn glass btn-press" bindtap="goToSubmit">
        <text class="submit-icon">✏️</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="skeleton skeleton-card"></view>
  </view>

  <!-- 加载失败兜底 -->
  <view class="section" wx:elif="{{loadError}}">
    <view class="empty glass" style="margin: 120rpx 40rpx; padding: 60rpx 40rpx; border-radius: 24rpx; text-align: center;">
      <text style="font-size: 72rpx;">🕸️</text>
      <view style="font-size: 30rpx; color: #94a3b8; margin-top: 20rpx;">网络开小差了</view>
      <view class="empty-btn glass" bindtap="loadData" style="display: inline-block; margin-top: 32rpx; padding: 16rpx 48rpx; border-radius: 999rpx;">
        <text class="empty-btn-text">再试一次</text>
      </view>
    </view>
  </view>

  <!-- 今日新鲜 -->
  <view class="section" wx:if="{{!loading && !loadError && currentJoke}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot {{currentJoke.isTodayNew ? 'today' : ''}}"></view>
        <text class="section-title">{{currentJoke.isTodayNew ? '今日最新' : '今日新鲜'}}</text>
      </view>
      <text class="section-count">{{todayNewCount > 0 ? todayNewCount + '条最新' : freshCount + '条未看'}}</text>
    </view>
    
    <view class="recommend-card glass" style="position:relative;">
      <view class="card-color" style="background: {{currentJoke.color}}"></view>

      <!-- 收藏书签：右上角，不挤占评价按钮行 -->
      <view bindtap="toggleFavorite" style="position:absolute; top:20rpx; right:24rpx; padding:6rpx 10rpx;">
        <text style="font-size:40rpx;">{{favorited ? '❤️' : '🤍'}}</text>
      </view>

      <view class="card-meta">
        <view class="meta-dot" style="background: {{currentJoke.color}}"></view>
        <text class="meta-cat">{{currentJoke.category}}</text>
        <text class="meta-date">{{currentJoke.date}}</text>
        <view class="meta-badge" wx:if="{{currentJoke.isTodayNew}}">NEW</view>
      </view>

      <text class="card-title">{{currentJoke.title}}</text>
      <text class="card-content">{{currentJoke.content}}</text>

      <view class="card-images" wx:if="{{currentJoke.hasImage}}">
        <image
          class="card-img"
          wx:for="{{currentJoke.images}}"
          wx:for-item="imgUrl"
          wx:key="*this"
          src="{{imgUrl}}"
          mode="widthFix"
          bindtap="previewImage"
          data-url="{{imgUrl}}"
          data-urls="{{currentJoke.images}}"
        />
      </view>

      <view class="card-actions">
        <view class="action-btn like" bindtap="handleLike">
          <view class="action-icon-wrap">👍</view>
          <text class="action-num">{{currentJoke.likes}}</text>
        </view>

        <view class="action-btn neutral" bindtap="handleNeutral">
          <view class="action-icon-wrap">😐</view>
          <text class="action-num">{{currentJoke.neutrals}}</text>
        </view>

        <view class="action-btn dislike" bindtap="handleDislike">
          <view class="action-icon-wrap">👎</view>
          <text class="action-num">{{currentJoke.dislikes}}</text>
        </view>
      </view>

      <!-- 下一个：居中中等胶囊按钮，显眼但不占满 -->
      <view style="text-align:center; margin-top: 18rpx;">
        <view bindtap="nextJoke" style="display:inline-block; padding: 16rpx 72rpx; border-radius: 999rpx; background: linear-gradient(90deg, {{currentJoke.color || '#8b5cf6'}}, #8b5cf6);">
          <text style="color:#fff; font-size: 28rpx; font-weight: bold;">下一个 →</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 热门推荐 -->
  <view class="section" wx:if="{{!loading && hotJokes.length > 0}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot hot"></view>
        <text class="section-title">热门推荐</text>
      </view>
      <text class="section-count">{{hotJokes.length}}条热门</text>
    </view>
    
    <view class="hot-list">
      <view class="hot-item glass btn-press" 
        wx:for="{{hotJokes}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <text class="hot-title">{{item.title}}</text>
        <text class="hot-likes">👍{{item.likes}}</text>
      </view>
    </view>
  </view>
</view>

<!--pages/search/search.wxml - 搜索优化 -->
<view class="page-wrapper {{pageClass}}">
  <!-- 顶部 -->
  <view class="header">
    <view class="brand">
      <view class="brand-dot"></view>
      <text class="brand-name">搜索笑话</text>
    </view>
    
    <view class="theme-btn glass btn-press" bindtap="toggleTheme">
      <text class="theme-icon">{{themeIcon}}</text>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box glass">
      <input 
        class="search-input"
        placeholder="搜索笑话关键词..."
        value="{{keyword}}"
        bindinput="handleInput"
        bindconfirm="handleSearch"
      />
      <view class="search-btn btn-press" bindtap="handleSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="section" wx:if="{{results.length === 0 && !loading}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot hot"></view>
        <text class="section-title">热门搜索</text>
      </view>
    </view>
    
    <view class="keywords-grid">
      <view class="keyword-item glass btn-press"
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        bindtap="searchHotKeyword"
        data-keyword="{{item}}"
      >
        <text class="keyword-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索历史 -->
  <view class="section" wx:if="{{history.length > 0 && results.length === 0 && !loading}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot history"></view>
        <text class="section-title">搜索历史</text>
      </view>
      <text class="clear-btn btn-press" bindtap="clearHistory">清除</text>
    </view>
    
    <view class="keywords-grid">
      <view class="keyword-item glass btn-press"
        wx:for="{{history}}"
        wx:key="*this"
        bindtap="searchHistoryKeyword"
        data-keyword="{{item}}"
      >
        <text class="keyword-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="section" wx:if="{{results.length > 0}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot results"></view>
        <text class="section-title">搜索结果</text>
      </view>
      <text class="section-count">{{results.length}}条</text>
    </view>
    
    <view class="results-list">
      <view class="result-item glass btn-press"
        wx:for="{{results}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <text class="result-title">{{item.title}}</text>
        <text class="result-category">{{item.category}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">搜索中...</text>
  </view>
</view>
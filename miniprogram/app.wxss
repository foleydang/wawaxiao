/* app.wxss - 全局样式 */

/* 夜间模式（默认） */
page {
  --safe-top: env(safe-area-inset-top);
  --safe-bottom: env(safe-area-inset-bottom);
  
  --primary: #667eea;
  --accent: #f093fb;
  
  /* 夜间模式颜色 */
  --bg: #0f0f23;
  --bg-light: #1a1a2e;
  --card: rgba(255,255,255,0.05);
  --border: rgba(255,255,255,0.1);
  --text: #ffffff;
  --text-secondary: rgba(255,255,255,0.7);
  --text-muted: rgba(255,255,255,0.4);
  
  background: #0f0f23;
  color: #ffffff;
  
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
}

/* 通用样式 */
.glass {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
}

/* 日间模式 */
.page-wrapper.light-mode {
  --bg: #f8f9fa;
  --bg-light: #ffffff;
  --card: rgba(0,0,0,0.04);
  --border: rgba(0,0,0,0.1);
  --text: #1a1a2e;
  --text-secondary: #555555;
  --text-muted: #888888;
  
  background: #f8f9fa !important;
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .glass {
  background: rgba(0,0,0,0.04) !important;
  border-color: rgba(0,0,0,0.1) !important;
}

.page-wrapper.light-mode .brand-name,
.page-wrapper.light-mode .section-title,
.page-wrapper.light-mode .card-title,
.page-wrapper.light-mode .hot-title,
.page-wrapper.light-mode .category-name,
.page-wrapper.light-mode .main-title,
.page-wrapper.light-mode .joke-title,
.page-wrapper.light-mode .fav-title,
.page-wrapper.light-mode .result-title,
.page-wrapper.light-mode .more-title,
.page-wrapper.light-mode .empty-title {
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .meta-cat,
.page-wrapper.light-mode .card-content,
.page-wrapper.light-mode .section-count,
.page-wrapper.light-mode .action-num,
.page-wrapper.light-mode .hot-stats,
.page-wrapper.light-mode .category-count,
.page-wrapper.light-mode .joke-preview,
.page-wrapper.light-mode .joke-likes,
.page-wrapper.light-mode .main-content,
.page-wrapper.light-mode .stat-label,
.page-wrapper.light-mode .fav-preview,
.page-wrapper.light-mode .fav-stats,
.page-wrapper.light-mode .result-preview,
.page-wrapper.light-mode .result-stats,
.page-wrapper.light-mode .more-stats {
  color: #555555 !important;
}

.page-wrapper.light-mode .hot-cat,
.page-wrapper.light-mode .joke-cat,
.page-wrapper.light-mode .joke-seen,
.page-wrapper.light-mode .fav-cat,
.page-wrapper.light-mode .result-cat,
.page-wrapper.light-mode .more-cat,
.page-wrapper.light-mode .empty-desc {
  color: #888888 !important;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, var(--bg-light) 25%, var(--card) 50%, var(--bg-light) 75%);
  background-size: 200% 100%;
  animation: skeleton 1.2s ease-in-out infinite;
}

@keyframes skeleton {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton-card {
  height: 200rpx;
  margin: 28rpx;
  border-radius: 16rpx;
}

.skeleton-title {
  height: 36rpx;
  width: 60%;
  margin: 16rpx 0;
  border-radius: 8rpx;
}

.skeleton-content {
  height: 28rpx;
  width: 80%;
  margin: 8rpx 0;
  border-radius: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 28rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-size: 40rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.empty-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
}

.empty-btn-text {
  font-size: 30rpx;
  font-weight: 500;
}

/* 动画 */
.fade-up {
  animation: fadeUp 0.35s ease-out;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 按钮点击效果 */
.btn-press:active {
  opacity: 0.7;
  transform: scale(0.98);
}

<page class="{{pageClass}}">

<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <view class="brand">
      <view class="brand-dot"></view>
      <text class="brand-name">哇哇笑</text>
    </view>
    
    <view class="header-right">
      <view class="theme-btn glass" bindtap="toggleTheme">
        <text class="theme-icon">{{themeIcon}}</text>
      </view>
      <view class="search-btn glass" bindtap="goToSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
  </view>

  <!-- 今日新鲜 -->
  <view class="section" wx:if="{{currentJoke}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot"></view>
        <text class="section-title">今日新鲜</text>
      </view>
      <text class="section-count">{{freshCount}}条未看</text>
    </view>
    
    <!-- 推荐卡片 -->
    <view class="recommend-card glass">
      <view class="card-color" style="background: {{currentJoke.color}}"></view>
      
      <view class="card-meta">
        <view class="meta-dot" style="background: {{currentJoke.color}}"></view>
        <text class="meta-cat">{{currentJoke.category}}</text>
        <view class="meta-badge" wx:if="{{currentJoke.isHot}}">HOT</view>
      </view>
      
      <text class="card-title">{{currentJoke.title}}</text>
      <text class="card-content">{{currentJoke.content}}</text>
      
      <!-- 图片 -->
      <view class="card-images" wx:if="{{currentJoke.hasImage}}">
        <image 
          class="card-img"
          wx:for="{{currentJoke.images}}"
          wx:for-item="imgUrl"
          wx:key="*this"
          src="{{imgUrl}}"
          mode="widthFix"
          bindtap="previewImage"
          data-url="{{imgUrl}}"
          data-urls="{{currentJoke.images}}"
        />
      </view>
      
      <!-- 操作按钮 -->
      <view class="card-actions">
        <view class="action-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
          <text class="action-icon">{{liked ? '❤️' : '🤍'}}</text>
          <text class="action-num">{{currentJoke.likes}}</text>
        </view>
        
        <view class="action-btn {{disliked ? 'disliked' : ''}}" bindtap="toggleDislike">
          <text class="action-icon">{{disliked ? '👎' : '👎🏻'}}</text>
          <text class="action-num">{{currentJoke.dislikes}}</text>
        </view>
        
        <button class="action-btn share-btn" open-type="share">
          <text class="action-icon">📤</text>
          <text class="action-num">{{currentJoke.shares}}</text>
        </button>
        
        <view class="action-btn next-btn" bindtap="nextJoke">
          <text class="next-text">下一个</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 热门推荐 -->
  <view class="hot-section" wx:if="{{hotJokes.length > 0}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot hot"></view>
        <text class="section-title">热门推荐</text>
      </view>
    </view>
    
    <view class="hot-grid">
      <view 
        class="hot-card glass fade-up"
        wx:for="{{hotJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="hot-color" style="background: {{item.color}}"></view>
        <text class="hot-title">{{item.title}}</text>
        <view class="hot-meta">
          <text class="hot-cat">{{item.category}}</text>
          <text class="hot-stats">{{item.likes}}❤️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分类快捷入口 -->
  <view class="category-section">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot"></view>
        <text class="section-title">分类浏览</text>
      </view>
    </view>
    
    <view class="category-grid">
      <view 
        class="category-card glass"
        wx:for="{{categories}}"
        wx:key="name"
        bindtap="goToCategory"
        data-category="{{item.name}}"
      >
        <view class="category-color" style="background: {{item.color}}"></view>
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
        <text class="category-count">{{item.count}}条</text>
      </view>
    </view>
  </view>
</view>

</page>

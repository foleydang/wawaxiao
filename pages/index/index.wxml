<view class="page">
  <view class="header">
    <view class="brand">
      <view class="brand-dot"></view>
      <text class="brand-name gradient-text">哇哇笑</text>
    </view>
    
    <view class="search-bar glass" bindtap="goToSearch">
      <text class="search-text">搜索笑话</text>
      <view class="search-arrow"></view>
    </view>
  </view>

  <scroll-view class="categories" scroll-x show-scrollbar="{{false}}">
    <view 
      class="cat-item {{currentCategory === item.name ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="name"
      bindtap="switchCategory"
      data-category="{{item.name}}"
    >
      <view class="cat-dot" style="background: {{item.color}}"></view>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 今日新鲜 -->
  <view class="section" wx:if="{{todayJokes.length > 0}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="title-bar"></view>
        <text class="section-title">今日新鲜</text>
      </view>
      <text class="section-badge">{{todayJokes.length}}条没看过</text>
    </view>
    
    <scroll-view class="today-scroll" scroll-x show-scrollbar="{{false}}">
      <view 
        class="today-card"
        wx:for="{{todayJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="today-color" style="background: {{item.color}}"></view>
        <text class="today-title">{{item.title}}</text>
        <view class="today-stats">
          <text class="stat-num">{{item.likes}}</text>
          <text class="stat-label">喜欢</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 再看一次 -->
  <view class="section" wx:if="{{seenJokes.length > 0 && showSeen}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="title-bar seen"></view>
        <text class="section-title seen-text">再看一次</text>
      </view>
      <view class="toggle-seen" bindtap="toggleShowSeen">
        <text class="toggle-text">隐藏</text>
      </view>
    </view>
    
    <view class="joke-list">
      <view 
        class="joke-card fade-up"
        wx:for="{{seenJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="joke-color seen-color"></view>
        <view class="joke-body">
          <text class="joke-title">{{item.title}}</text>
          <text class="joke-preview">{{item.preview}}</text>
        </view>
        <view class="joke-right">
          <view class="stats-mini">
            <text class="mini-num">{{item.likes}}</text>
            <text class="mini-sep">/</text>
            <text class="mini-num bad">{{item.dislikes}}</text>
          </view>
          <view class="seen-badge">已看过</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 笑话库 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="title-bar"></view>
        <text class="section-title">{{currentCategory === '全部' ? '笑话库' : currentCategory}}</text>
      </view>
      <text class="section-count">{{filteredJokes.length}}条</text>
    </view>

    <view class="skeleton-wrap" wx:if="{{loading}}">
      <view class="skeleton-card glass" wx:for="{{3}}" wx:key="index">
        <view class="skeleton-bar skeleton"></view>
        <view class="skeleton-bar short skeleton"></view>
      </view>
    </view>

    <view class="joke-list" wx:else>
      <view 
        class="joke-card fade-up"
        wx:for="{{filteredJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="joke-color" style="background: {{item.color}}"></view>
        <view class="joke-body">
          <text class="joke-title">{{item.title}}</text>
          <text class="joke-preview">{{item.preview}}</text>
        </view>
        <view class="joke-right">
          <view class="stats-mini">
            <text class="mini-num">{{item.likes}}</text>
            <text class="mini-sep">/</text>
            <text class="mini-num bad">{{item.dislikes}}</text>
          </view>
          <view class="mini-share">📤{{item.shares}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮按钮 -->
  <view class="float-btn" bindtap="showRandom">
    <view class="float-bg gradient-btn"></view>
    <view class="float-content">
      <text class="float-icon">⚡</text>
      <text class="float-text">随机</text>
    </view>
  </view>
</view>

<!-- 随机弹窗 -->
<view class="modal-overlay {{showModal ? 'show' : ''}}" bindtap="hideModal">
  <view class="modal glass scale-in" catchtap="preventClose">
    <view class="modal-header">
      <view class="modal-bar" style="background: {{randomJoke.color}}"></view>
      <text class="modal-category">{{randomJoke.category}}</text>
    </view>
    
    <view class="modal-body">
      <text class="modal-title">{{randomJoke.title}}</text>
      <text class="modal-content">{{randomJoke.content}}</text>
    </view>
    
    <view class="modal-footer">
      <view class="modal-btn outline glass" bindtap="showRandom">
        <text class="modal-btn-text">换一个</text>
      </view>
      <view class="modal-btn primary gradient-btn" bindtap="hideModal">
        <text class="modal-btn-text-white">开心了</text>
      </view>
    </view>
  </view>
</view>

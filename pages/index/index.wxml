<page class="{{pageClass}}">

<view class="container">
  <!-- 顶部：标题 + 主题 -->
  <view class="header">
    <view class="brand">
      <view class="brand-dot"></view>
      <text class="brand-name">今日新鲜</text>
      <text class="brand-count">{{freshCount}}条未看</text>
    </view>
    
    <view class="theme-btn glass" bindtap="toggleTheme">
      <text class="theme-icon">{{themeIcon}}</text>
    </view>
  </view>

  <!-- 推荐笑话卡片 -->
  <view class="recommend-card glass" wx:if="{{currentJoke}}">
    <view class="card-color" style="background: {{currentJoke.color}}"></view>
    
    <view class="card-meta">
      <view class="meta-dot" style="background: {{currentJoke.color}}"></view>
      <text class="meta-cat">{{currentJoke.category}}</text>
      <view class="meta-badge" wx:if="{{currentJoke.isHot}}">HOT</view>
      <view class="meta-badge" wx:if="{{currentJoke.hasImage}}">图</view>
    </view>
    
    <text class="card-title">{{currentJoke.title}}</text>
    
    <!-- 图片 -->
    <view class="card-images" wx:if="{{currentJoke.hasImage}}">
      <image 
        class="card-img"
        wx:for="{{currentJoke.images}}"
        wx:key="*this"
        src="{{item}}"
        mode="widthFix"
        bindtap="previewImage"
        data-url="{{item}}"
      />
    </view>
    
    <text class="card-content">{{currentJoke.content}}</text>
    
    <!-- 操作按钮 -->
    <view class="card-actions">
      <view class="action-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
        <text class="action-icon">{{liked ? '❤️' : '🤍'}}</text>
        <text class="action-num">{{currentJoke.likes}}</text>
      </view>
      
      <view class="action-btn {{disliked ? 'disliked' : ''}}" bindtap="toggleDislike">
        <text class="action-icon">{{disliked ? '👎' : '👎🏻'}}</text>
        <text class="action-num">{{currentJoke.dislikes}}</text>
      </view>
      
      <button class="action-btn share-btn" open-type="share">
        <text class="action-icon">📤</text>
        <text class="action-num">{{currentJoke.shares}}</text>
      </button>
      
      <view class="action-btn next-btn" bindtap="nextJoke">
        <text class="action-icon">⚡</text>
        <text class="action-text">下一个</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!currentJoke && !loading}}">
    <view class="empty-icon glass">
      <text class="empty-face">😊</text>
    </view>
    <text class="empty-title">今天的新鲜笑话都看完了</text>
    <text class="empty-desc">去看看笑话库发现更多吧</text>
    <view class="empty-btn glass" bindtap="goToLibrary">
      <text class="empty-btn-text">去笑话库</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-card glass">
      <view class="skeleton-bar skeleton"></view>
      <view class="skeleton-bar skeleton"></view>
      <view class="skeleton-bar short skeleton"></view>
    </view>
  </view>

  <!-- 更多推荐（已看过的） -->
  <view class="seen-section" wx:if="{{seenJokes.length > 0 && showSeen}}">
    <view class="section-header" bindtap="toggleShowSeen">
      <view class="section-title-wrap">
        <view class="title-bar seen"></view>
        <text class="section-title">再看一次 {{showSeen ? '▼' : '▶'}}</text>
      </view>
      <text class="section-count">{{seenJokes.length}}条</text>
    </view>
    
    <scroll-view class="seen-scroll" scroll-x show-scrollbar="{{false}}" wx:if="{{showSeen}}">
      <view 
        class="seen-card glass"
        wx:for="{{seenJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="seen-color" style="background: {{item.color}}"></view>
        <text class="seen-title">{{item.title}}</text>
        <view class="seen-meta">
          <text class="seen-cat">{{item.category}}</text>
          <text class="seen-stats">{{item.likes}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 提示 -->
  <view class="tip" wx:if="{{freshCount > 0}}">
    <text class="tip-text">点击「下一个」随机换一条新笑话</text>
  </view>
</view>

</page>

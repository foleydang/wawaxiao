<!--pages/index/index.wxml - 极简现代风格-->
<view class="page">
  <!-- 顶部区域 -->
  <view class="header">
    <view class="header-content">
      <!-- Logo + 标题 -->
      <view class="brand">
        <view class="brand-icon"></view>
        <text class="brand-name gradient-text">哇哇笑</text>
      </view>
      
      <!-- 统计数字 -->
      <view class="stats">
        <view class="stat-item">
          <text class="stat-value">{{stats.total}}</text>
          <text class="stat-label">TOTAL</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{stats.hotCount}}</text>
          <text class="stat-label">HOT</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{favoritesCount}}</text>
          <text class="stat-label">LIKED</text>
        </view>
      </view>
    </view>
    
    <!-- 搜索入口 -->
    <view class="search-trigger glass-card" bindtap="showSearch">
      <view class="search-icon-wrap">
        <view class="search-line"></view>
        <view class="search-circle"></view>
      </view>
      <text class="search-text">搜索笑话</text>
      <view class="search-arrow">→</view>
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="category-section">
    <view 
      class="category-item {{currentCategory === item.name ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="name"
      bindtap="switchCategory"
      data-category="{{item.name}}"
    >
      <view class="category-indicator" style="background: {{item.color}}"></view>
      <text class="category-name">{{item.name}}</text>
      <text class="category-count">{{item.count}}</text>
    </view>
  </view>

  <!-- 热门精选 -->
  <view class="hot-section" wx:if="{{currentCategory === '全部' && hotJokes.length > 0}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="title-line hot"></view>
        <text class="section-title">热门精选</text>
      </view>
      <view class="refresh-btn" bindtap="refreshHot">
        <view class="refresh-icon"></view>
      </view>
    </view>
    
    <scroll-view class="hot-scroll" scroll-x show-scrollbar="{{false}}">
      <view 
        class="hot-card"
        wx:for="{{hotJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="hot-card-bg" style="background: linear-gradient(135deg, {{item.gradient}})"></view>
        <view class="hot-card-content">
          <view class="hot-rank">{{index + 1}}</view>
          <text class="hot-title">{{item.title}}</text>
          <view class="hot-meta">
            <text class="hot-likes">{{item.likes}}</text>
            <text class="hot-dot">·</text>
            <text class="hot-category">{{item.category}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 笑话列表 -->
  <view class="list-section">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="title-line"></view>
        <text class="section-title">最新</text>
      </view>
      <text class="list-count">{{jokes.length}}条</text>
    </view>

    <!-- 骨架屏 -->
    <view class="skeleton-list" wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{3}}" wx:key="index">
        <view class="skeleton-bar skeleton"></view>
        <view class="skeleton-bar short skeleton"></view>
      </view>
    </view>

    <!-- 笑话卡片 -->
    <view class="joke-list" wx:else>
      <view 
        class="joke-card fade-up"
        wx:for="{{jokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
        style="animation-delay: {{index * 0.06}}s"
      >
        <!-- 左侧色条 -->
        <view class="joke-color" style="background: {{item.color}}"></view>
        
        <!-- 内容 -->
        <view class="joke-body">
          <view class="joke-header">
            <text class="joke-category tag">{{item.category}}</text>
            <view class="joke-hot" wx:if="{{item.isHot}}">
              <view class="hot-dot-pulse"></view>
              <text class="hot-label">HOT</text>
            </view>
          </view>
          
          <text class="joke-title">{{item.title}}</text>
          <text class="joke-preview">{{item.preview}}</text>
          
          <view class="joke-footer">
            <text class="joke-likes">{{item.likes}} 次喜欢</text>
            <view class="joke-arrow">
              <view class="arrow-line"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮按钮 -->
  <view class="float-btn" bindtap="showRandomJoke">
    <view class="float-bg"></view>
    <view class="float-content">
      <view class="float-icon">
        <view class="dice-dot"></view>
      </view>
      <text class="float-text">RANDOM</text>
    </view>
  </view>
</view>

<!-- 随机弹窗 -->
<view class="modal-overlay {{showModal ? 'show' : ''}}" bindtap="hideModal">
  <view class="modal scale-in" catchtap="preventClose">
    <view class="modal-header">
      <view class="modal-gradient" style="background: linear-gradient(135deg, {{randomJoke.color}})"></view>
      <text class="modal-category">{{randomJoke.category}}</text>
    </view>
    
    <view class="modal-body">
      <text class="modal-title">{{randomJoke.title}}</text>
      <text class="modal-content">{{randomJoke.content}}</text>
    </view>
    
    <view class="modal-footer">
      <view class="modal-btn outline" bindtap="getAnotherRandom">
        <text class="btn-text">换一个</text>
      </view>
      <view class="modal-btn primary gradient-btn" bindtap="hideModal">
        <text class="btn-text">开心了</text>
      </view>
    </view>
  </view>
</view>

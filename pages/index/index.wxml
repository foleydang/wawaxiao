<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部装饰 -->
  <view class="header-decoration">
    <view class="deco-circle circle-1"></view>
    <view class="deco-circle circle-2"></view>
    <view class="deco-circle circle-3"></view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view 
      class="category-item {{currentCategory === item.name ? 'active' : ''}}" 
      wx:for="{{categories}}" 
      wx:key="name"
      bindtap="switchCategory"
      data-category="{{item.name}}"
    >
      <text class="category-icon">{{item.icon}}</text>
      <text class="category-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 热门推荐 -->
  <view class="section" wx:if="{{currentCategory === '全部'}}">
    <view class="section-header">
      <view class="section-title">
        <text class="title-icon">🔥</text>
        <text class="title-text">今日热门</text>
      </view>
      <view class="section-more" bindtap="refreshJokes">
        <text class="refresh-icon">🔄</text>
        <text class="refresh-text">换一批</text>
      </view>
    </view>
    
    <!-- 热门笑话卡片 -->
    <view class="hot-joke-card" bindtap="goToDetail" data-id="{{hotJoke.id}}">
      <view class="hot-badge">HOT</view>
      <view class="joke-header">
        <text class="joke-category">{{hotJoke.category}}</text>
        <text class="joke-title">{{hotJoke.title}}</text>
      </view>
      <view class="joke-content">{{hotJoke.content}}</view>
      <view class="joke-footer">
        <view class="joke-likes">
          <text class="like-icon">❤️</text>
          <text class="like-count">{{hotJoke.likes}}</text>
        </view>
        <view class="joke-action">
          <text class="action-text">点击查看更多</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 笑话列表 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">
        <text class="title-icon">✨</text>
        <text class="title-text">{{currentCategory === '全部' ? '全部笑话' : currentCategory + '笑话'}}</text>
      </view>
      <text class="joke-count">共{{jokes.length}}条</text>
    </view>

    <view class="joke-list">
      <view 
        class="joke-card" 
        wx:for="{{jokes}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="card-top">
          <view class="card-category">
            <text class="category-tag">{{item.category}}</text>
          </view>
          <view class="card-hot" wx:if="{{item.isHot}}">
            <text class="hot-text">🔥 热门</text>
          </view>
        </view>
        
        <view class="card-title">{{item.title}}</view>
        
        <view class="card-preview">
          {{item.content.length > 50 ? item.content.substring(0, 50) + '...' : item.content}}
        </view>
        
        <view class="card-footer">
          <view class="card-likes">
            <text class="heart-icon">❤️</text>
            <text class="likes-num">{{item.likes}}</text>
          </view>
          <view class="card-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="footer-decoration">
    <text class="footer-text">😂 每天开心一笑 😂</text>
  </view>

  <!-- 随机笑话按钮 -->
  <view class="random-btn" bindtap="showRandomJoke">
    <text class="random-icon">🎲</text>
  </view>
</view>

<!-- 随机笑话弹窗 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal">
  <view class="modal-content" catchtap="preventClose">
    <view class="modal-header">
      <text class="modal-title">🎉 随机笑话</text>
      <view class="modal-close" bindtap="hideModal">
        <text class="close-icon">✕</text>
      </view>
    </view>
    <view class="modal-body">
      <view class="modal-category">{{randomJoke.category}}</view>
      <view class="modal-joke-title">{{randomJoke.title}}</view>
      <view class="modal-joke-content">{{randomJoke.content}}</view>
    </view>
    <view class="modal-footer">
      <view class="modal-btn secondary" bindtap="getAnotherRandom">
        <text class="btn-text">换一个</text>
      </view>
      <view class="modal-btn primary" bindtap="hideModal">
        <text class="btn-text">开心了</text>
      </view>
    </view>
  </view>
</view>
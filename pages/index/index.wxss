/* pages/index/index.wxss - 现代风格 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fe 0%, #e8ecf3 100%);
  padding-bottom: 140rpx;
  overflow-x: hidden;
}

/* ========== 顶部区域 ========== */
.header-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 48rpx 32rpx 120rpx;
  position: relative;
}

.header-bg::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -40rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent, #f8f9fe);
  border-radius: 50% 50% 0 0;
}

.header-content {
  position: relative;
  z-index: 10;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #888;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #667eea;
}

.stats-label {
  font-size: 24rpx;
  color: #8888a8;
  margin-top: 4rpx;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(102, 126, 234, 0.2);
}

/* ========== 分类区域 ========== */
.category-section {
  padding: 32rpx 24rpx 16rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.08);
  position: relative;
  min-width: 100rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  transform: scale(1.05);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.category-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #f0f2fe 0%, #e8ecf3 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.category-item.active .category-icon-wrap {
  background: rgba(255, 255, 255, 0.2);
}

.category-icon {
  font-size: 32rpx;
}

.category-name {
  font-size: 26rpx;
  color: #4a4a6a;
  font-weight: 500;
}

.category-item.active .category-name {
  color: #fff;
}

.category-count {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.category-item.active .category-count {
  background: rgba(255, 255, 255, 0.3);
}

/* ========== 热门区域 ========== */
.hot-section {
  padding: 24rpx 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.section-action {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 24rpx;
}

.action-text {
  font-size: 24rpx;
  color: #667eea;
  margin-right: 4rpx;
}

.action-arrow {
  font-size: 24rpx;
  color: #667eea;
}

.joke-total {
  font-size: 24rpx;
  color: #8888a8;
}

/* 热门横向滑动 */
.hot-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.hot-card {
  display: inline-block;
  width: 260rpx;
  height: 280rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.12);
}

.hot-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.hot-content {
  position: relative;
  padding: 24rpx 20rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.hot-badge {
  position: absolute;
  top: -40rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.hot-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-top: 24rpx;
  display: block;
  white-space: normal;
  line-height: 1.4;
}

.hot-preview {
  font-size: 24rpx;
  color: #8888a8;
  line-height: 1.5;
  margin-top: 12rpx;
  flex: 1;
  display: block;
  white-space: normal;
  word-break: break-all;
}

.hot-meta {
  display: flex;
  align-items: center;
  margin-top: auto;
}

.hot-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.hot-likes {
  font-size: 22rpx;
  color: #8888a8;
}

/* ========== 笑话列表 ========== */
.joke-section {
  padding: 0 24rpx;
}

/* 骨架屏 */
.skeleton-list {
  padding: 24rpx 0;
}

.skeleton-card {
  display: flex;
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.08);
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  margin-right: 20rpx;
}

.skeleton-content {
  flex: 1;
}

.skeleton-title {
  height: 32rpx;
  width: 60%;
  margin-bottom: 16rpx;
}

.skeleton-text {
  height: 24rpx;
  width: 80%;
}

/* 笑话卡片 */
.joke-list {
  padding: 24rpx 0;
}

.joke-card {
  display: flex;
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
}

.joke-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.12);
}

.joke-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f0f2fe 0%, #e8ecf3 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.joke-avatar.hot {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.avatar-emoji {
  font-size: 36rpx;
}

.joke-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.joke-header {
  margin-bottom: 12rpx;
}

.joke-tags {
  display: flex;
  gap: 8rpx;
}

.joke-tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.joke-tag.hot {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #fff;
}

.joke-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  display: block;
}

.joke-preview {
  font-size: 26rpx;
  color: #8888a8;
  line-height: 1.5;
  flex: 1;
  display: block;
}

.joke-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.joke-stats {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.stat-num {
  font-size: 24rpx;
  color: #8888a8;
}

.joke-arrow {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 300;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx 0;
}

.load-text {
  font-size: 26rpx;
  color: #8888a8;
}

/* ========== 悬浮按钮 ========== */
.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.35);
  z-index: 100;
  overflow: hidden;
}

.float-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.float-icon {
  font-size: 40rpx;
  position: relative;
  z-index: 1;
}

.float-text {
  font-size: 22rpx;
  color: #fff;
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
}

.float-btn:active {
  transform: scale(0.9);
}

/* ========== 弹窗样式 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-container {
  width: 600rpx;
  background: #fff;
  border-radius: 48rpx;
  overflow: hidden;
  position: relative;
  animation: modalSlide 0.4s ease;
}

@keyframes modalSlide {
  from { transform: translateY(100rpx) scale(0.9); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

.modal-header {
  height: 160rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-emoji {
  font-size: 80rpx;
  position: relative;
  z-index: 1;
}

.modal-body {
  padding: 32rpx;
}

.modal-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  display: block;
}

.modal-content {
  font-size: 28rpx;
  color: #4a4a6a;
  line-height: 1.8;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.outline {
  background: rgba(102, 126, 234, 0.1);
  border: 2rpx solid #667eea;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #667eea;
}

.modal-btn.primary .btn-text {
  color: #fff;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-icon {
  font-size: 24rpx;
  color: #fff;
}

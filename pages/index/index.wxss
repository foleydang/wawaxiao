/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(120rpx + var(--safe-bottom));
}

/* ========== 顶部 ========== */
.header {
  padding: calc(56rpx + var(--safe-top)) 32rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 10rpx;
  height: 10rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 5rpx;
  margin-right: 16rpx;
}

.brand-name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  min-width: 160rpx;
  border-radius: 12rpx;
}

.search-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* ========== 分类 ========== */
.categories {
  padding: 12rpx 32rpx 28rpx;
  white-space: nowrap;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 20rpx;
  margin-right: 12rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
}

.cat-item.active {
  background: rgba(102,126,234,0.15);
  border-color: rgba(102,126,234,0.4);
}

.cat-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.cat-name {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.cat-item.active .cat-name {
  color: var(--text);
  font-weight: 500;
}

/* ========== 板块 ========== */
.section {
  padding: 28rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 6rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.title-bar.seen {
  background: var(--text-muted);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 2rpx;
}

.seen-text {
  color: var(--text-secondary);
}

.section-badge {
  font-size: 26rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.15);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.section-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.toggle-seen {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  background: var(--card);
  border-radius: 8rpx;
}

/* ========== 今日新鲜（紧凑） ========== */
.today-scroll {
  padding: 12rpx 32rpx;
  white-space: nowrap;  /* 横向滚动区域保持nowrap */
}

.today-card {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  padding: 20rpx;
  margin-right: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}

.today-color {
  width: 100%;
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 16rpx;
}

.today-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 12rpx;
  /* 允许换行，最多显示2行 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.today-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.today-cat {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.today-likes {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* ========== 笑话卡片（允许换行） ========== */
.joke-list {
  padding: 12rpx 32rpx;
}

.joke-card {
  display: flex;
  align-items: flex-start;  /* 改为flex-start，允许内容撑高 */
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.joke-card:active {
  background: rgba(255,255,255,0.08);
}

.joke-color {
  width: 6rpx;
  height: 100%;
  min-height: 48rpx;
  border-radius: 3rpx;
  margin-right: 20rpx;
  align-self: stretch;  /* 色条撑满整个卡片高度 */
}

.seen-color {
  background: var(--text-muted) !important;
}

.joke-body {
  flex: 1;
  min-width: 0;
}

.joke-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 8rpx;
  /* 允许换行，最多2行 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.joke-preview {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  /* 允许换行，最多2行 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.joke-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-left: 16rpx;
  align-self: center;  /* 右侧信息垂直居中 */
}

.joke-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.joke-likes {
  font-size: 26rpx;
  color: var(--text-muted);
}

.seen-badge {
  font-size: 24rpx;
  color: var(--text-muted);
  background: var(--card);
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}

/* ========== 骨架屏 ========== */
.skeleton-wrap {
  padding: 32rpx;
}

.skeleton-card {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.skeleton-bar {
  height: 28rpx;
  border-radius: 6rpx;
  margin-bottom: 10rpx;
}

.skeleton-bar.short {
  width: 50%;
}

/* ========== 悬浮按钮 ========== */
.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(100rpx + var(--safe-bottom));
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  overflow: hidden;
  z-index: 100;
}

.float-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  box-shadow: 0 0 30rpx rgba(102,126,234,0.4);
}

.float-content {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.float-icon {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 4rpx;
}

.float-text {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 500;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  width: 600rpx;
  max-height: 70vh;
  overflow: hidden;
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  padding: 24rpx;
}

.modal-bar {
  height: 6rpx;
  border-radius: 3rpx;
  margin-bottom: 16rpx;
}

.modal-category {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.modal-body {
  padding: 0 24rpx 24rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

.modal-content {
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;  /* 弹窗内容保持换行 */
}

.modal-footer {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.outline {
  background: var(--card);
  border: 1rpx solid var(--border);
}

.modal-btn.primary {
  border: none;
}

.modal-btn-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.modal-btn-text-white {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

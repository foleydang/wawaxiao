/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFE8E8 100%);
  padding-bottom: 120rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部装饰 */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.3;
}

.circle-1 {
  width: 120rpx;
  height: 120rpx;
  background: #FF6B6B;
  top: -40rpx;
  right: 60rpx;
}

.circle-2 {
  width: 80rpx;
  height: 80rpx;
  background: #FFE66D;
  top: 40rpx;
  right: 180rpx;
}

.circle-3 {
  width: 60rpx;
  height: 60rpx;
  background: #4ECDC4;
  top: 80rpx;
  left: 40rpx;
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  padding: 24rpx 0;
  margin-bottom: 16rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  margin: 0 12rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.1);
  transition: all 0.3s ease;
}

.category-item:first-child {
  margin-left: 24rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
  transform: scale(1.05);
}

.category-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666666;
}

.category-item.active .category-name {
  color: #FFFFFF;
  font-weight: 500;
}

/* 板块通用样式 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(255, 107, 107, 0.1);
  border-radius: 20rpx;
}

.refresh-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.refresh-text {
  font-size: 24rpx;
  color: #FF6B6B;
}

.joke-count {
  font-size: 24rpx;
  color: #999999;
}

/* 热门笑话卡片 */
.hot-joke-card {
  margin: 0 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F5 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.15);
  position: relative;
  overflow: hidden;
}

.hot-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 0 24rpx 0 24rpx;
}

.joke-header {
  margin-bottom: 20rpx;
}

.joke-category {
  display: inline-block;
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.joke-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 12rpx;
}

.joke-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
}

.joke-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 107, 107, 0.1);
}

.joke-likes {
  display: flex;
  align-items: center;
}

.like-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.like-count {
  font-size: 26rpx;
  color: #999999;
}

.joke-action {
  display: flex;
  align-items: center;
}

.action-text {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-right: 8rpx;
}

.action-arrow {
  font-size: 28rpx;
  color: #FF6B6B;
}

/* 笑话列表 */
.joke-list {
  padding: 0 24rpx;
}

.joke-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.08);
  transition: all 0.3s ease;
}

.joke-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.1);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.card-hot {
  background: rgba(255, 230, 109, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.hot-text {
  font-size: 20rpx;
  color: #E6A800;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.card-preview {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-likes {
  display: flex;
  align-items: center;
}

.heart-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.likes-num {
  font-size: 24rpx;
  color: #999999;
}

.card-arrow {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 107, 107, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 300;
}

/* 底部装饰 */
.footer-decoration {
  text-align: center;
  padding: 40rpx;
  margin-top: 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 随机笑话按钮 */
.random-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
  z-index: 100;
}

.random-btn:active {
  transform: scale(0.95);
}

.random-icon {
  font-size: 48rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 28rpx;
  color: #FFFFFF;
}

.modal-body {
  padding: 32rpx;
}

.modal-category {
  display: inline-block;
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.modal-joke-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.modal-joke-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.secondary {
  background: rgba(255, 107, 107, 0.1);
}

.modal-btn.primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.modal-btn .btn-text {
  font-size: 28rpx;
  color: #FF6B6B;
}

.modal-btn.primary .btn-text {
  color: #FFFFFF;
  font-weight: 500;
}
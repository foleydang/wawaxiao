/* pages/index/index.wxss - 极简深色风格 */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 140rpx;
}

/* ========== 顶部区域 ========== */
.header {
  padding: 48rpx 24rpx 32rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 品牌 */
.brand {
  display: flex;
  align-items: center;
}

.brand-icon {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.stat-divider {
  width: 1rpx;
  height: 32rpx;
  background: var(--border);
}

/* 搜索入口 */
.search-trigger {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
}

.search-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  margin-right: 16rpx;
}

.search-line {
  width: 16rpx;
  height: 2rpx;
  background: var(--primary);
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  transform: rotate(45deg);
}

.search-circle {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
}

.search-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-muted);
}

.search-arrow {
  font-size: 28rpx;
  color: var(--primary);
}

/* ========== 分类 ========== */
.category-section {
  display: flex;
  padding: 0 24rpx;
  gap: 12rpx;
  overflow-x: auto;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  transition: all 0.3s;
  gap: 8rpx;
}

.category-item.active {
  background: rgba(102,126,234,0.15);
  border-color: var(--primary);
}

.category-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.category-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.category-item.active .category-name {
  color: var(--text);
  font-weight: 500;
}

.category-count {
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--bg-light);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.category-item.active .category-count {
  background: rgba(102,126,234,0.2);
  color: var(--primary);
}

/* ========== 热门区域 ========== */
.hot-section {
  padding: 32rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.title-line {
  width: 4rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.title-line.hot {
  background: linear-gradient(180deg, var(--accent) 0%, var(--primary) 100%);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}

.refresh-btn {
  width: 40rpx;
  height: 40rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-icon {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid var(--primary);
  border-radius: 50%;
  border-top-color: transparent;
}

.list-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 热门卡片 */
.hot-scroll {
  padding: 0 24rpx;
}

.hot-card {
  display: inline-block;
  width: 200rpx;
  height: 220rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.hot-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.hot-card-content {
  position: relative;
  padding: 20rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.hot-rank {
  font-size: 48rpx;
  font-weight: 900;
  color: rgba(255,255,255,0.2);
  margin-bottom: 12rpx;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.95);
  line-height: 1.3;
  flex: 1;
}

.hot-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.hot-dot {
  margin: 0 6rpx;
}

/* ========== 列表区域 ========== */
.list-section {
  padding: 32rpx 24rpx;
}

/* 骨架屏 */
.skeleton-list {
  padding: 24rpx 0;
}

.skeleton-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--card);
  border-radius: var(--radius-md);
}

.skeleton-bar {
  height: 28rpx;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
}

.skeleton-bar.short {
  width: 60%;
}

/* 笑话卡片 */
.joke-list {
  padding: 24rpx 0;
}

.joke-card {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  overflow: hidden;
  transition: all 0.3s;
}

.joke-card:active {
  background: var(--card-hover);
  transform: scale(0.98);
}

.joke-color {
  width: 6rpx;
  min-height: 140rpx;
}

.joke-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.joke-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.joke-hot {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hot-dot-pulse {
  width: 8rpx;
  height: 8rpx;
  background: var(--accent);
  border-radius: 4rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.hot-label {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.joke-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.joke-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  flex: 1;
}

.joke-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.joke-likes {
  font-size: 24rpx;
  color: var(--text-muted);
}

.joke-arrow {
  width: 32rpx;
  height: 32rpx;
  background: rgba(102,126,234,0.1);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-line {
  width: 12rpx;
  height: 2rpx;
  background: var(--primary);
}

.arrow-line::after {
  content: '';
  width: 6rpx;
  height: 6rpx;
  border-right: 2rpx solid var(--primary);
  border-top: 2rpx solid var(--primary);
  transform: rotate(45deg);
  position: absolute;
  right: 2rpx;
}

/* ========== 悬浮按钮 ========== */
.float-btn {
  position: fixed;
  right: 24rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  overflow: hidden;
  box-shadow: var(--shadow), 0 0 60rpx rgba(102,126,234,0.5);
  z-index: 100;
}

.float-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
}

.float-content {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.float-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dice-dot {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 4rpx;
}

.float-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  width: 640rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.modal-header {
  height: 120rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.modal-category {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 600;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
  padding: 8rpx 20rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
  display: block;
}

.modal-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.outline {
  background: transparent;
  border: 1rpx solid var(--border-light);
}

.modal-btn.primary {
  border: none;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.modal-btn.primary .btn-text {
  color: var(--text);
}

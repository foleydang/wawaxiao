/* index.wxss */

.container {
  min-height: 100vh;
  padding-bottom: calc(100rpx + var(--safe-bottom));
}

/* 顶部 */
.header {
  padding: calc(52rpx + var(--safe-top)) 28rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  margin-right: 12rpx;
}

.search-icon {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid var(--text-secondary);
  border-radius: 50%;
  position: relative;
  margin-right: 12rpx;
}

.search-icon::after {
  content: '';
  width: 8rpx;
  height: 2rpx;
  background: var(--text-secondary);
  position: absolute;
  right: -6rpx;
  bottom: -2rpx;
  transform: rotate(45deg);
}

.search-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.theme-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 24rpx;
}

/* 分类 */
.categories {
  padding: 8rpx 28rpx 24rpx;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  background: var(--card);
}

.cat-item.active {
  background: rgba(102,126,234,0.12);
}

.cat-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.cat-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.cat-item.active .cat-name {
  color: var(--text);
  font-weight: 500;
}

.cat-count {
  font-size: 22rpx;
  color: var(--accent);
  margin-left: 8rpx;
}

/* 板块 */
.section {
  padding: 20rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 28rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 4rpx;
  height: 18rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.title-bar.seen {
  background: var(--text-muted);
}

.section-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.section-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 新鲜卡片 */
.today-scroll {
  padding: 8rpx 28rpx;
  white-space: nowrap;
}

.today-card {
  display: inline-flex;
  flex-direction: column;
  width: 160rpx;
  padding: 14rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
}

.today-color {
  width: 100%;
  height: 3rpx;
  border-radius: 2rpx;
  margin-bottom: 12rpx;
}

.today-title {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.today-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.today-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

.today-stats {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 笑话列表 */
.joke-list {
  padding: 8rpx 28rpx;
}

.joke-card {
  display: flex;
  align-items: flex-start;
  padding: 14rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
}

.joke-color {
  width: 4rpx;
  min-height: 44rpx;
  border-radius: 2rpx;
  margin-right: 14rpx;
  align-self: stretch;
}

.seen-color {
  background: var(--text-muted);
}

.joke-body {
  flex: 1;
  min-width: 0;
}

.joke-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.joke-preview {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.joke-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 14rpx;
  align-self: center;
}

.joke-likes {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.seen-tag {
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--bg-light);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  margin-top: 4rpx;
}

/* 骨架屏 */
.skeleton-wrap {
  padding: 28rpx;
}

.skeleton-card {
  padding: 14rpx;
  margin-bottom: 12rpx;
}

.skeleton-bar {
  height: 24rpx;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
}

.skeleton-bar.short {
  width: 50%;
}

/* 随机按钮 */
.float-btn {
  position: fixed;
  right: 28rpx;
  bottom: calc(80rpx + var(--safe-bottom));
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  overflow: hidden;
  z-index: 100;
}

.float-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  box-shadow: 0 0 20rpx rgba(102,126,234,0.3);
}

.float-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  width: 560rpx;
  max-height: 70vh;
  border-radius: 18rpx;
}

.modal-header {
  padding: 18rpx;
}

.modal-bar {
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 12rpx;
}

.modal-cat {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.modal-body {
  padding: 0 18rpx 18rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.modal-images {
  margin-bottom: 16rpx;
}

.modal-image {
  width: 100%;
  border-radius: 12rpx;
}

.modal-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  padding: 18rpx;
  gap: 12rpx;
}

.modal-btn {
  flex: 1;
  height: 60rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.outline {
  background: var(--card);
}

.modal-btn-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.modal-btn-text-white {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

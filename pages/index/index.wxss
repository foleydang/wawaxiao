/* index.wxss - 首页：今日新鲜 */

.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

/* 顶部 */
.header {
  padding: calc(60rpx + var(--safe-top)) 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 10rpx;
  height: 10rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 5rpx;
  margin-right: 16rpx;
}

.brand-name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text);
}

.brand-count {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 16rpx;
}

.theme-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 28rpx;
}

/* 推荐卡片 */
.recommend-card {
  margin: 32rpx;
  padding: 28rpx;
  border-radius: 20rpx;
}

.card-color {
  height: 6rpx;
  border-radius: 3rpx;
  margin-bottom: 24rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.meta-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.meta-cat {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.meta-badge {
  font-size: 24rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.15);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.card-title {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
  line-height: 1.4;
}

/* 图片区域（限制尺寸） */
.card-images {
  margin-bottom: 24rpx;
}

.card-img {
  width: 100%;
  max-width: 600rpx;
  max-height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  margin-top: 32rpx;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
}

.share-btn::after {
  display: none;
}

.action-btn.liked {
  background: rgba(240,147,251,0.15);
  border: none;
}

.action-btn.disliked {
  background: rgba(255,100,100,0.15);
  border: none;
}

.action-btn.next-btn {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border: none;
}

.action-icon {
  font-size: 32rpx;
}

.action-num {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.action-btn.liked .action-num,
.action-btn.disliked .action-num,
.action-btn.next-btn .action-num,
.next-btn .action-text {
  color: var(--text);
  font-weight: 500;
}

.action-text {
  font-size: 30rpx;
  color: #ffffff;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-face {
  font-size: 36rpx;
}

.empty-title {
  font-size: 34rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 36rpx;
  border-radius: 12rpx;
}

.empty-btn-text {
  font-size: 32rpx;
  color: var(--text);
  font-weight: 500;
}

/* 加载中 */
.loading-wrap {
  padding: 32rpx;
}

.loading-card {
  padding: 28rpx;
  border-radius: 20rpx;
}

.skeleton-bar {
  height: 32rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-bar.short {
  width: 60%;
  margin-bottom: 0;
}

/* 已看过 */
.seen-section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 6rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.title-bar.seen {
  background: var(--text-muted);
}

.section-title {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.section-count {
  font-size: 26rpx;
  color: var(--text-muted);
}

.seen-scroll {
  padding: 12rpx 32rpx;
  white-space: nowrap;
}

.seen-card {
  display: inline-flex;
  flex-direction: column;
  width: 180rpx;
  padding: 16rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
}

.seen-color {
  width: 100%;
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 12rpx;
}

.seen-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.seen-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.seen-cat {
  font-size: 24rpx;
  color: var(--text-muted);
}

.seen-stats {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 提示 */
.tip {
  padding: 24rpx 32rpx 32rpx;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
}

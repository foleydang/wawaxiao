/* pages/index/index.wxss - 极简深色风格 v2 */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(120rpx + var(--safe-bottom));
}

/* ========== 顶部区域 ========== */
.header {
  padding: calc(48rpx + var(--safe-top)) 24rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 8rpx;
  height: 8rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  min-width: 160rpx;
}

.search-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.search-arrow {
  width: 16rpx;
  height: 2rpx;
  background: var(--text-muted);
  margin-left: 12rpx;
  position: relative;
}

.search-arrow::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-right: 2rpx solid var(--text-muted);
  border-bottom: 2rpx solid var(--text-muted);
  transform: rotate(-45deg);
  position: absolute;
  right: -4rpx;
  top: -4rpx;
}

/* ========== 分类 ========== */
.categories {
  padding: 8rpx 24rpx 24rpx;
  white-space: nowrap;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 16rpx;
  margin-right: 8rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
}

.cat-item.active {
  background: rgba(102,126,234,0.15);
  border-color: rgba(102,126,234,0.3);
}

.cat-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.cat-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.cat-item.active .cat-name {
  color: var(--text);
  font-weight: 500;
}

/* ========== 板块通用 ========== */
.section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 4rpx;
  height: 20rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.title-bar.seen {
  background: var(--text-muted);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}

.seen-text {
  color: var(--text-muted);
}

.section-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.1);
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.section-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.toggle-seen {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 6rpx 12rpx;
  background: var(--card);
  border-radius: 6rpx;
}

/* ========== 今日新鲜 ========== */
.today-scroll {
  padding: 8rpx 24rpx;
  white-space: nowrap;
}

.today-card {
  display: inline-block;
  width: 180rpx;
  height: 140rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-lg);
  padding: 16rpx;
  position: relative;
  overflow: hidden;
}

.today-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.today-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
  display: block;
  height: 80rpx;
  overflow: hidden;
  position: relative;
}

.today-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  position: relative;
}

.today-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.today-category {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ========== 笑话卡片 ========== */
.joke-list, .seen-list {
  padding: 8rpx 24rpx;
}

.joke-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.joke-card:active {
  background: rgba(255,255,255,0.08);
}

.joke-color {
  width: 4rpx;
  height: 100%;
  min-height: 60rpx;
  border-radius: 2rpx;
  margin-right: 16rpx;
}

.seen-color {
  background: var(--text-muted) !important;
}

.joke-body {
  flex: 1;
  min-width: 0;
}

.joke-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.joke-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.joke-category {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.hot-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--accent);
  margin-left: 12rpx;
  letter-spacing: 1rpx;
}

.seen-badge {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
}

.joke-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  display: block;
  margin-bottom: 6rpx;
}

.joke-preview {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.joke-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.joke-likes {
  font-size: 22rpx;
  color: var(--text-muted);
}

.seen-mark {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.seen-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--text-muted);
}

/* ========== 骨架屏 ========== */
.skeleton-wrap {
  padding: 24rpx;
}

.skeleton-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.skeleton-bar {
  height: 24rpx;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
}

.skeleton-bar.short {
  width: 60%;
}

/* ========== 悬浮按钮 ========== */
.float-btn {
  position: fixed;
  right: 24rpx;
  bottom: calc(100rpx + var(--safe-bottom));
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  overflow: hidden;
  z-index: 100;
}

.float-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  box-shadow: 0 0 30rpx rgba(102,126,234,0.4);
}

.float-content {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.float-icon {
  font-size: 24rpx;
  color: var(--text);
  margin-bottom: 4rpx;
}

.float-text {
  font-size: 20rpx;
  color: var(--text);
  font-weight: 500;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  width: 600rpx;
  max-height: 70vh;
  overflow: hidden;
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  padding: 20rpx;
}

.modal-bar {
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 16rpx;
}

.modal-top {
  display: flex;
  align-items: center;
}

.modal-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.modal-category {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.modal-body {
  padding: 0 20rpx 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
  display: block;
}

.modal-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  padding: 20rpx;
  gap: 12rpx;
}

.modal-btn {
  flex: 1;
  height: 64rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.outline {
  background: var(--card);
  border: 1rpx solid var(--border);
}

.modal-btn.primary {
  border: none;
}

.modal-btn-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.modal-btn-text-white {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

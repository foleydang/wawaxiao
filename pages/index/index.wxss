/* index.wxss */

.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

/* 顶部 */
.header {
  padding: calc(56rpx + var(--safe-top)) 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 8rpx;
  height: 8rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.header-right {
  display: flex;
  gap: 8rpx;
}

.theme-btn, .search-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon, .search-icon {
  font-size: 20rpx;
}

/* 板块 */
.section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 28rpx 16rpx;
}

.section-left {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 4rpx;
  height: 16rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.section-dot.hot {
  background: var(--accent);
}

.section-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.section-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 推荐卡片 */
.recommend-card {
  margin: 0 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.card-color {
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 10rpx;
}

.meta-cat {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.meta-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.12);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
  line-height: 1.4;
  display: block;
}

.card-content {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
  margin-bottom: 20rpx;
}

.card-images {
  margin-bottom: 20rpx;
}

.card-img {
  width: 100%;
  max-width: 600rpx;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 10rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
}

.share-btn::after {
  display: none;
}

.action-btn.liked {
  background: rgba(240,147,251,0.12);
  border: none;
}

.action-btn.disliked {
  background: rgba(255,100,100,0.12);
  border: none;
}

.action-btn.next-btn {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border: none;
  flex: 1.3;
}

.action-icon {
  font-size: 24rpx;
}

.action-num {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-btn.liked .action-num,
.action-btn.disliked .action-num {
  color: var(--text);
}

.next-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 热门推荐 */
.hot-section {
  padding: 24rpx 0;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 28rpx;
  gap: 12rpx;
}

.hot-card {
  width: calc(50% - 6rpx);
  padding: 16rpx;
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
}

.hot-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
}

.hot-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  padding-left: 12rpx;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hot-meta {
  display: flex;
  justify-content: space-between;
  padding-left: 12rpx;
}

.hot-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

.hot-stats {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 分类 */
.category-section {
  padding: 24rpx 0;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 28rpx;
  gap: 12rpx;
}

.category-card {
  width: calc(50% - 6rpx);
  padding: 20rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.category-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  border-radius: 2rpx;
}

.category-icon {
  font-size: 32rpx;
  margin-left: 12rpx;
  margin-right: 12rpx;
}

.category-name {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.category-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: auto;
}

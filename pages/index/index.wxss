/* index.wxss */

.page-wrapper {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
  background: var(--bg);
  color: var(--text);
}

.page-wrapper.light-mode {
  background: #f8f9fa !important;
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .glass {
  background: rgba(0,0,0,0.04) !important;
  border-color: rgba(0,0,0,0.1) !important;
}

.page-wrapper.light-mode .brand-name,
.page-wrapper.light-mode .section-title,
.page-wrapper.light-mode .card-title,
.page-wrapper.light-mode .hot-title,
.page-wrapper.light-mode .empty-title {
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .meta-cat,
.page-wrapper.light-mode .card-content,
.page-wrapper.light-mode .section-count,
.page-wrapper.light-mode .action-num,
.page-wrapper.light-mode .hot-likes,
.page-wrapper.light-mode .empty-desc {
  color: #555555 !important;
}

.page-wrapper.light-mode .hot-cat,
.page-wrapper.light-mode .empty-btn-text {
  color: #888888 !important;
}

/* 顶部 */
.header {
  padding: calc(56rpx + var(--safe-top)) 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 8rpx;
  height: 8rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
}

.header-right {
  display: flex;
  gap: 12rpx;
}

.theme-btn, .search-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon, .search-icon {
  font-size: 22rpx;
}

/* 加载状态 */
.loading-state {
  padding: 28rpx;
}

/* 板块 */
.section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 28rpx 16rpx;
}

.section-left {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 4rpx;
  height: 16rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.section-dot.hot {
  background: var(--accent);
}

.section-dot.today {
  background: #43e97b;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
}

.section-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 推荐卡片 */
.recommend-card {
  margin: 0 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.card-color {
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 10rpx;
}

.meta-cat {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.meta-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.12);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  line-height: 1.4;
  display: block;
}

.card-content {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 16rpx;
}

.card-images {
  margin-bottom: 16rpx;
}

.card-img {
  width: 100%;
  max-width: 600rpx;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  transition: all 0.2s ease;
}

.share-btn::after {
  display: none;
}

.action-btn.liked {
  background: rgba(240,147,251,0.15);
  border: none;
}

.action-btn.disliked {
  background: rgba(255,100,100,0.15);
  border: none;
}

.action-btn.next-btn {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border: none;
  flex: 1.4;
}

.action-icon {
  font-size: 28rpx;
}

.action-num {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.action-btn.liked .action-num,
.action-btn.disliked .action-num {
  color: var(--text);
}

.next-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 28rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.empty-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
}

.empty-btn-text {
  font-size: 30rpx;
  font-weight: 500;
}

/* 热门推荐 - 强制2x2网格 */
.hot-section {
  padding: 24rpx 0 0 0;
}

.hot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;  /* 强制2列 */
  grid-template-rows: auto auto;   /* 2行 */
  gap: 12rpx;
  padding: 0 28rpx 28rpx 28rpx;
}

.hot-card {
  height: 140rpx;  /* 固定高度 */
  padding: 16rpx;
  border-radius: 14rpx;
  position: relative;
  display: flex;
  align-items: center;
}

.hot-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  border-radius: 2rpx 0 0 2rpx;
}

.hot-content {
  flex: 1;
  padding-left: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.3;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hot-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hot-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

.hot-likes {
  font-size: 22rpx;
  color: var(--text-secondary);
}

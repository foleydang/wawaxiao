<page class="{{pageClass}}">

<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-left">
      <view class="title-bar"></view>
      <text class="header-title">喜欢</text>
      <text class="header-count">{{favorites.length}}</text>
    </view>
    
    <view class="theme-btn glass" bindtap="toggleTheme">
      <text class="theme-icon">{{themeIcon}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{favorites.length === 0}}">
    <view class="empty-icon glass">
      <text class="empty-heart">♡</text>
    </view>
    <text class="empty-title">还没有喜欢的笑话</text>
    <text class="empty-desc">看到好笑的记得点喜欢哦</text>
    <view class="empty-btn glass" bindtap="goToIndex">
      <text class="empty-btn-text">去看看</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list" wx:else>
    <view 
      class="fav-card glass"
      wx:for="{{favorites}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="fav-color" style="background: {{item.color}}"></view>
      <view class="fav-body">
        <text class="fav-title">{{item.title}}</text>
        <text class="fav-preview">{{item.preview}}</text>
      </view>
      <view class="fav-right">
        <view class="fav-meta">
          <text class="fav-cat">{{item.category}}</text>
          <text class="fav-stats">{{item.likes}}{{item.hasImage ? '图' : ''}}</text>
        </view>
        <view class="delete-btn glass" catchtap="deleteFavorite" data-id="{{item.id}}">
          <text class="delete-text">×</text>
        </view>
      </view>
    </view>
  </view>
</view>

</page>

<view class="container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="deco-circle circle-1"></view>
    <view class="deco-circle circle-2"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{favorites.length === 0}}">
    <view class="empty-icon">💔</view>
    <view class="empty-title">还没有收藏</view>
    <view class="empty-desc">去首页找找喜欢的笑话吧~</view>
    <view class="empty-btn" bindtap="goToIndex">去看看</view>
  </view>

  <!-- 收藏列表 -->
  <view class="favorite-list" wx:else>
    <view class="section-header">
      <text class="section-title">❤️ 我的收藏</text>
      <text class="favorite-count">共{{favorites.length}}条</text>
    </view>

    <view 
      class="favorite-card" 
      wx:for="{{favorites}}" 
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="card-top">
        <view class="card-category">
          <text class="category-tag">{{item.category}}</text>
        </view>
        <view class="card-hot" wx:if="{{item.isHot}}">
          <text class="hot-text">🔥 热门</text>
        </view>
      </view>
      
      <view class="card-title">{{item.title}}</view>
      
      <view class="card-preview">
        {{item.content.length > 50 ? item.content.substring(0, 50) + '...' : item.content}}
      </view>
      
      <view class="card-footer">
        <view class="card-likes">
          <text class="heart-icon">❤️</text>
          <text class="likes-num">{{item.likes}}</text>
        </view>
        <view class="card-actions">
          <view class="delete-btn" catchtap="removeFavorite" data-id="{{item.id}}">
            <text class="delete-icon">🗑️</text>
          </view>
          <view class="card-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip">
      <text class="tip-text">点击卡片查看详情，点击垃圾桶取消收藏</text>
    </view>
  </view>
</view>

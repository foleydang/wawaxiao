.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fe 0%, #e8ecf3 100%);
  padding-bottom: 120rpx;
  position: relative;
}

.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  pointer-events: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  margin-top: 100rpx;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: rgba(102,126,234,0.1);
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8888a8;
  margin-bottom: 48rpx;
}

.empty-btn {
  position: relative;
  overflow: hidden;
  border-radius: 48rpx;
  padding: 24rpx 64rpx;
}

.btn-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
}

.empty-btn .btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* 收藏区域 */
.favorite-section {
  padding: 24rpx;
  position: relative;
  z-index: 1;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 16rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.header-count {
  font-size: 24rpx;
  color: #8888a8;
}

/* 收藏卡片 */
.favorite-list {
  padding: 24rpx 0;
}

.favorite-card {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  transition: all 0.3s;
}

.favorite-card:active {
  transform: scale(0.98);
}

.card-avatar {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, rgba(102,126,234,0.1) 0%, rgba(118,75,162,0.1) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.avatar-emoji {
  font-size: 32rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.card-tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102,126,234,0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.card-tag.hot {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #fff;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-bottom: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-preview {
  font-size: 24rpx;
  color: #8888a8;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.likes-wrap {
  display: flex;
  align-items: center;
}

.likes-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.likes-num {
  font-size: 22rpx;
  color: #8888a8;
}

.delete-btn {
  width: 40rpx;
  height: 40rpx;
  background: rgba(255,107,107,0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn:active {
  background: rgba(255,107,107,0.2);
}

.delete-icon {
  font-size: 20rpx;
}

.footer-tip {
  text-align: center;
  padding: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8888a8;
}

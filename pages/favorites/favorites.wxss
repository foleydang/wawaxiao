.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.icon-line {
  width: 32rpx;
  height: 2rpx;
  background: var(--text-muted);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  border-radius: var(--radius);
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 2rpx;
}

/* 列表 */
.list-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.header-line {
  width: 4rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 2rpx;
}

.header-count {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-left: auto;
}

/* 卡片 */
.fav-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 12rpx;
  overflow: hidden;
}

.card-color {
  width: 6rpx;
  height: 100%;
  min-height: 100rpx;
}

.card-body {
  flex: 1;
  padding: 20rpx;
  min-width: 0;
}

.card-category {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-preview {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  gap: 8rpx;
}

.card-likes {
  font-size: 22rpx;
  color: var(--text-muted);
}

.delete-btn {
  width: 32rpx;
  height: 32rpx;
  background: rgba(240,147,251,0.1);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-line {
  width: 12rpx;
  height: 2rpx;
  background: #f093fb;
}

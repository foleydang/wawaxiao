.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.header {
  padding: calc(48rpx + var(--safe-top)) 24rpx 24rpx;
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-count {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-left: 16rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--card);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-line {
  width: 24rpx;
  height: 2rpx;
  background: var(--text-muted);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius);
}

.empty-btn-text {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.list {
  padding: 24rpx;
}

.fav-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.fav-card:active {
  background: rgba(255,255,255,0.08);
}

.fav-color {
  width: 4rpx;
  height: 100%;
  min-height: 60rpx;
  border-radius: 2rpx;
  margin-right: 16rpx;
}

.fav-body {
  flex: 1;
  min-width: 0;
}

.fav-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.fav-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.fav-category {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fav-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 6rpx;
  display: block;
}

.fav-preview {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
}

.fav-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.fav-likes {
  font-size: 22rpx;
  color: var(--text-muted);
}

.delete-btn {
  width: 32rpx;
  height: 32rpx;
  background: rgba(240,147,251,0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-line {
  width: 14rpx;
  height: 2rpx;
  background: #f093fb;
}

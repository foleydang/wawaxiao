/* favorites.wxss */

.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.header {
  padding: calc(56rpx + var(--safe-top)) 28rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 4rpx;
  height: 18rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.header-count {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.theme-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-heart {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

/* 列表 */
.list {
  padding: 28rpx;
}

.fav-card {
  display: flex;
  align-items: flex-start;
  padding: 14rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
}

.fav-color {
  width: 4rpx;
  min-height: 44rpx;
  border-radius: 2rpx;
  margin-right: 14rpx;
  align-self: stretch;
}

.fav-body {
  flex: 1;
  min-width: 0;
}

.fav-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.fav-preview {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.fav-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 14rpx;
  align-self: center;
  gap: 8rpx;
}

.fav-meta {
  display: flex;
  gap: 8rpx;
}

.fav-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

.fav-stats {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.delete-btn {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-text {
  font-size: 18rpx;
  color: var(--accent);
}

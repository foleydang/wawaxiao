.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.header {
  padding: calc(56rpx + var(--safe-top)) 32rpx 32rpx;
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 42rpx;
  font-weight: 600;
}

.header-count {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-left: 20rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-line {
  width: 28rpx;
  height: 3rpx;
  background: var(--text-muted);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 30rpx;
  color: var(--text-muted);
  margin-bottom: 36rpx;
}

.empty-btn {
  padding: 18rpx 36rpx;
  border-radius: 12rpx;
}

.empty-btn-text {
  font-size: 32rpx;
  color: var(--text);
  font-weight: 500;
}

.list {
  padding: 32rpx;
}

.fav-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.fav-card:active {
  background: rgba(255,255,255,0.08);
}

.fav-color {
  width: 6rpx;
  height: 100%;
  min-height: 56rpx;
  border-radius: 3rpx;
  margin-right: 20rpx;
}

.fav-body {
  flex: 1;
  min-width: 0;
}

.fav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  display: block;
  margin-bottom: 6rpx;
}

.fav-preview {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.fav-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 16rpx;
}

.fav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.fav-cat {
  font-size: 26rpx;
  color: var(--text-muted);
}

.delete-btn {
  width: 36rpx;
  height: 36rpx;
  background: rgba(240,147,251,0.15);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-text {
  font-size: 22rpx;
  color: #f093fb;
}

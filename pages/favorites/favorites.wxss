/* favorites.wxss */

.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.header {
  padding: calc(56rpx + var(--safe-top)) 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-dot {
  width: 4rpx;
  height: 16rpx;
  background: var(--accent);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.header-count {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.theme-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 20rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 28rpx;
}

.empty-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-face {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.empty-btn {
  padding: 14rpx 32rpx;
}

.empty-btn-text {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

/* 列表 */
.list {
  padding: 28rpx;
}

.fav-card {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.fav-color {
  width: 4rpx;
  min-height: 48rpx;
  border-radius: 2rpx;
  margin-right: 16rpx;
  align-self: stretch;
}

.fav-body {
  flex: 1;
  min-width: 0;
}

.fav-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.fav-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.fav-right {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  align-self: center;
  gap: 12rpx;
}

.fav-stats {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.delete-btn {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-text {
  font-size: 18rpx;
  color: var(--accent);
}

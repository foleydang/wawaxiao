<page class="{{pageClass}}">

<view class="container">
  <!-- 搜索栏 -->
  <view class="search-header">
    <view class="back-btn glass" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    
    <view class="search-box glass">
      <view class="search-icon"></view>
      <input 
        class="search-input"
        type="text"
        placeholder="搜索笑话"
        value="{{keyword}}"
        bindinput="onInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearInput">
        <text class="clear-text">×</text>
      </view>
    </view>
    
    <view class="theme-btn glass" bindtap="toggleTheme">
      <text class="theme-icon">{{themeIcon}}</text>
    </view>
  </view>

  <!-- 结果 -->
  <view class="results" wx:if="{{results.length > 0}}">
    <view class="result-header">
      <text class="result-count">找到{{results.length}}条</text>
    </view>
    
    <view 
      class="result-card glass"
      wx:for="{{results}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="result-color" style="background: {{item.color}}"></view>
      <view class="result-body">
        <text class="result-title">{{item.title}}</text>
        <text class="result-preview">{{item.preview}}</text>
      </view>
      <view class="result-right">
        <text class="result-cat">{{item.category}}</text>
        <text class="result-stats">{{item.likes}}{{item.hasImage ? '图' : ''}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{searched && results.length === 0}}">
    <text class="empty-title">没有找到"{{keyword}}"相关笑话</text>
    <text class="empty-desc">换个关键词试试</text>
  </view>

  <!-- 历史 -->
  <view class="history" wx:if="{{!searched && history.length > 0}}">
    <view class="history-header">
      <text class="history-title">搜索历史</text>
      <view class="clear-history" bindtap="clearHistory">
        <text class="clear-history-text">清空</text>
      </view>
    </view>
    
    <view class="history-list">
      <view 
        class="history-item glass"
        wx:for="{{history}}"
        wx:key="*this"
        bindtap="searchHistory"
        data-keyword="{{item}}"
      >
        <text class="history-text">{{item}}</text>
      </view>
    </view>
  </view>
</view>

</page>

<view class="page">
  <!-- 安全区域 + 搜索栏 -->
  <view class="search-header">
    <view class="search-bar glass">
      <view class="search-icon">
        <view class="search-circle"></view>
        <view class="search-line"></view>
      </view>
      <input 
        class="search-input" 
        placeholder="搜索笑话..." 
        placeholder-class="search-placeholder"
        focus="{{true}}" 
        value="{{keyword}}" 
        bindinput="onInput" 
        bindconfirm="onSearch"
      />
      <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearKeyword">
        <text class="clear-text">✕</text>
      </view>
    </view>
  </view>

  <!-- 历史 -->
  <view class="history-section" wx:if="{{!hasSearch && history.length > 0}}">
    <view class="section-header">
      <text class="section-title">搜索历史</text>
      <text class="clear-history" bindtap="clearHistory">清空</text>
    </view>
    <view class="history-list">
      <view class="history-item glass" wx:for="{{history}}" wx:key="*this" bindtap="searchHistory" data-keyword="{{item}}">
        <text class="history-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 结果 -->
  <view class="result-section" wx:if="{{hasSearch}}">
    <view class="section-header">
      <text class="result-count">找到 {{results.length}} 条</text>
    </view>

    <view class="empty" wx:if="{{results.length === 0}}">
      <text class="empty-title">没有找到相关笑话</text>
      <text class="empty-tip">换个关键词试试</text>
    </view>

    <view class="result-list" wx:else>
      <view 
        class="result-card glass fade-up" 
        wx:for="{{results}}" 
        wx:key="id" 
        bindtap="goToDetail" 
        data-id="{{item.id}}"
      >
        <view class="result-color" style="background: {{item.color}}"></view>
        <view class="result-body">
          <text class="result-title">{{item.title}}</text>
          <text class="result-preview">{{item.preview}}</text>
        </view>
        <view class="result-right">
          <view class="result-dot" style="background: {{item.color}}"></view>
          <text class="result-category">{{item.category}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

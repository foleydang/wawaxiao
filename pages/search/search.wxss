.page {
  min-height: 100vh;
  background: var(--bg);
}

.search-header {
  padding: calc(24rpx + var(--safe-top)) 24rpx 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 12rpx 16rpx;
}

.search-icon-wrap {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  margin-right: 12rpx;
}

.search-circle {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid var(--text-muted);
  border-radius: 9rpx;
}

.search-line {
  width: 8rpx;
  height: 2rpx;
  background: var(--text-muted);
  position: absolute;
  bottom: 2rpx;
  right: 0;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.clear-btn {
  width: 20rpx;
  height: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-line {
  width: 14rpx;
  height: 2rpx;
  background: var(--text-muted);
  transform: rotate(45deg);
  position: relative;
}

.clear-line::after {
  content: '';
  width: 14rpx;
  height: 2rpx;
  background: var(--text-muted);
  position: absolute;
  transform: rotate(90deg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-muted);
}

.clear-history {
  font-size: 24rpx;
  color: var(--text-muted);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx;
  gap: 8rpx;
}

.history-item {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 10rpx 14rpx;
}

.history-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.result-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: var(--text-muted);
}

.result-list {
  padding: 8rpx 24rpx;
}

.result-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  margin-bottom: 12rpx;
  overflow: hidden;
}

.result-color {
  width: 4rpx;
  height: 100%;
  min-height: 70rpx;
}

.result-body {
  flex: 1;
  padding: 14rpx 16rpx;
  min-width: 0;
}

.result-top {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.result-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.result-category {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.result-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 6rpx;
}

.result-content {
  font-size: 24rpx;
  color: var(--text-muted);
}

.result-likes {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 14rpx;
}

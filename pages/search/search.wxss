.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fe 0%, #e8ecf3 100%);
}

/* 搜索栏 */
.search-header {
  padding: 24rpx;
  background: rgba(255,255,255,0.95);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(102,126,234,0.08);
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a2e;
}

.clear-btn {
  font-size: 24rpx;
  color: #8888a8;
  padding: 8rpx;
}

/* 通用section */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

/* 搜索历史 */
.history-section {
  padding: 24rpx 0;
}

.clear-history {
  font-size: 24rpx;
  color: #8888a8;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.history-item {
  background: rgba(102,126,234,0.08);
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
}

.history-text {
  font-size: 26rpx;
  color: #4a4a6a;
}

/* 热门搜索 */
.hot-section {
  padding: 24rpx 0;
}

.hot-list {
  padding: 16rpx 24rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.hot-rank {
  font-size: 28rpx;
  font-weight: 700;
  color: #667eea;
  margin-right: 16rpx;
}

.hot-text {
  font-size: 28rpx;
  color: #1a1a2e;
}

/* 搜索结果 */
.result-section {
  padding: 24rpx 0;
}

.result-count {
  font-size: 24rpx;
  color: #8888a8;
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #8888a8;
}

.result-list {
  padding: 16rpx 24rpx;
}

.result-card {
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.result-category {
  margin-bottom: 12rpx;
}

.category-tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102,126,234,0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  display: block;
}

.result-content {
  font-size: 26rpx;
  color: #8888a8;
  line-height: 1.5;
  display: block;
}

.result-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.meta-value {
  font-size: 24rpx;
  color: #8888a8;
}

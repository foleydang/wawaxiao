/* search.wxss */

.container {
  min-height: 100vh;
}

.header {
  padding: calc(16rpx + var(--safe-top)) 28rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.back-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 14rpx;
  height: 2rpx;
  background: var(--text-secondary);
  position: relative;
}

.back-arrow::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-left: 2rpx solid var(--text-secondary);
  border-bottom: 2rpx solid var(--text-secondary);
  transform: rotate(45deg);
  position: absolute;
  left: 2rpx;
  top: -5rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
}

.search-icon {
  font-size: 20rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.search-input::placeholder {
  color: var(--text-secondary);
}

.clear-btn {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-text {
  font-size: 16rpx;
  color: var(--text);
}

.theme-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 20rpx;
}

/* 结果 */
.results {
  padding: 28rpx;
}

.result-header {
  padding-bottom: 16rpx;
}

.result-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.result-card {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.result-color {
  width: 4rpx;
  min-height: 48rpx;
  border-radius: 2rpx;
  margin-right: 16rpx;
  align-self: stretch;
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.result-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.result-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 16rpx;
  align-self: center;
  gap: 6rpx;
}

.result-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

.result-stats {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 空结果 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 28rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 历史 */
.history {
  padding: 28rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.clear-history {
  padding: 4rpx 12rpx;
}

.clear-history-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.history-item {
  padding: 8rpx 16rpx;
}

.history-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.page {
  min-height: 100vh;
  background: var(--bg);
}

.search-header {
  padding: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  margin-right: 16rpx;
}

.search-circle {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: 50%;
}

.search-line {
  width: 10rpx;
  height: 2rpx;
  background: var(--primary);
  position: absolute;
  bottom: 4rpx;
  right: 0;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.clear-btn {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-line {
  width: 16rpx;
  height: 2rpx;
  background: var(--text-muted);
  transform: rotate(45deg);
  position: relative;
}

.clear-line::after {
  content: '';
  width: 16rpx;
  height: 2rpx;
  background: var(--text-muted);
  position: absolute;
  transform: rotate(90deg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.clear-history {
  font-size: 24rpx;
  color: var(--text-muted);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 8rpx;
}

.history-item {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 12rpx 16rpx;
}

.history-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.result-count {
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: var(--text-muted);
}

.result-list {
  padding: 0 24rpx;
}

.result-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 12rpx;
  overflow: hidden;
}

.result-color {
  width: 6rpx;
  height: 100%;
  min-height: 80rpx;
}

.result-body {
  flex: 1;
  padding: 20rpx;
  min-width: 0;
}

.result-category {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  margin-top: 8rpx;
  display: block;
}

.result-content {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  display: block;
}

.result-likes {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 20rpx;
}

/* pages/search/search.wxss - 搜索优化 */

.page-wrapper {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
  background: var(--bg);
  color: var(--text);
}

.page-wrapper.light-mode {
  background: #f8f9fa !important;
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .glass {
  background: rgba(0,0,0,0.04) !important;
  border-color: rgba(0,0,0,0.1) !important;
}

.page-wrapper.light-mode .brand-name,
.page-wrapper.light-mode .section-title,
.page-wrapper.light-mode .result-title {
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .result-category,
.page-wrapper.light-mode .keyword-text {
  color: #555555 !important;
}

/* 顶部 */
.header {
  padding: calc(56rpx + var(--safe-top)) 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.brand-name {
  font-size: 36rpx;
  font-weight: 600;
}

.glass {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
}

.btn-press {
  transition: transform 0.15s ease;
}

.btn-press:active {
  transform: scale(0.92);
}

.theme-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 20px;
}

/* 搜索框 */
.search-section {
  padding: 0 28rpx 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.search-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  font-size: 24px;
}

/* Section */
.section {
  padding: 0 28rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.section-dot.hot {
  background: #FF6B6B;
}

.section-dot.history {
  background: #4ECDC4;
}

.section-dot.results {
  background: #667eea;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 关键词网格 */
.keywords-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.keyword-item {
  padding: 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.keyword-text {
  font-size: 26rpx;
}

/* 结果列表 */
.results-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-item {
  padding: 24rpx;
  border-radius: 16rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.result-category {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 加载状态 */
.loading {
  padding: 100rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
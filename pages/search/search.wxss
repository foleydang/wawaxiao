.page {
  min-height: 100vh;
  background: var(--bg);
}

/* 搜索栏 */
.search-header {
  padding: calc(60rpx + var(--safe-top)) 32rpx 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  margin-right: 16rpx;
}

.search-circle {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 11rpx;
}

.search-line {
  width: 12rpx;
  height: 3rpx;
  background: var(--text-secondary);
  position: absolute;
  bottom: 4rpx;
  right: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 34rpx;
  color: var(--text);
  font-weight: 400;
}

.search-placeholder {
  font-size: 34rpx;
  color: var(--text-muted);
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 20rpx;
}

.clear-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 历史 */
.history-section {
  padding: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

.clear-history {
  font-size: 28rpx;
  color: var(--text-muted);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
}

.history-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* 结果 */
.result-section {
  padding: 24rpx 32rpx;
}

.result-count {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 30rpx;
  color: var(--text-muted);
}

.result-list {
  padding-top: 16rpx;
}

.result-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.result-color {
  width: 6rpx;
  height: 100%;
  min-height: 60rpx;
  border-radius: 3rpx;
  margin-right: 20rpx;
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-preview {
  font-size: 28rpx;
  color: var(--text-muted);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.result-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.result-category {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fe 0%, #e8ecf3 100%);
  padding-bottom: 120rpx;
  position: relative;
  overflow: hidden;
}

.bg-shapes {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  pointer-events: none;
  z-index: 0;
}

.shape {
  position: absolute;
  border-radius: 50%;
  opacity: 0.5;
}

.shape-1 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  top: -150rpx;
  right: -100rpx;
}

.shape-2 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  top: 100rpx;
  left: -80rpx;
}

/* 主卡片 */
.main-card {
  position: relative;
  z-index: 1;
  margin: 32rpx 24rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.12);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.category-badge {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
}

.badge-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.hot-badge {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.joke-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.4;
  display: block;
  margin-bottom: 32rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(102,126,234,0.2), transparent);
}

.divider-dot {
  font-size: 32rpx;
  margin: 0 24rpx;
}

.joke-content {
  font-size: 32rpx;
  color: #4a4a6a;
  line-height: 2;
  display: block;
  white-space: pre-wrap;
}

.joke-stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(102,126,234,0.1);
  gap: 32rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.stat-value {
  font-size: 26rpx;
  color: #8888a8;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.btn-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(102,126,234,0.08);
}

.btn-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  position: relative;
  z-index: 1;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
  color: #667eea;
}

.action-btn.liked .btn-text,
.action-btn.share .btn-text {
  color: #fff;
}

/* 更多推荐 */
.more-section {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.more-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.more-card {
  width: calc(50% - 8rpx);
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.more-emoji {
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.more-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more-likes {
  display: flex;
  align-items: center;
}

.heart {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.num {
  font-size: 22rpx;
  color: #8888a8;
}

.page {
  height: 100vh;
  background: var(--bg);
}

.main-scroll {
  height: 100vh;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.nav-bar {
  padding: calc(20rpx + var(--safe-top)) 32rpx 32rpx;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 16rpx;
  height: 3rpx;
  background: var(--text-secondary);
  position: relative;
}

.back-arrow::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-left: 3rpx solid var(--text-secondary);
  border-bottom: 3rpx solid var(--text-secondary);
  transform: rotate(45deg);
  position: absolute;
  left: 2rpx;
  top: -6rpx;
}

.main-card {
  margin: 32rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.color-bar {
  height: 6rpx;
  border-radius: 3rpx;
  margin-bottom: 24rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.meta-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.meta-category {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.meta-badge.hot {
  font-size: 24rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.15);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}

.main-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
  display: block;
  line-height: 1.4;
}

.main-content {
  font-size: 34rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 操作按钮 */
.action-row {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
}

.action-btn.liked {
  border: none;
}

.action-btn.disliked {
  border: none;
}

.action-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.dislike-bg {
  background: rgba(255,100,100,0.2);
}

.action-icon {
  font-size: 32rpx;
  position: relative;
}

.action-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
  position: relative;
}

.action-btn.liked .action-text,
.action-btn.disliked .action-text {
  color: var(--text);
}

/* 更多推荐 */
.more-section {
  padding: 32rpx;
}

.more-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.more-bar {
  width: 6rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.more-title {
  font-size: 32rpx;
  color: var(--text);
  font-weight: 500;
}

.more-grid {
  display: flex;
  gap: 16rpx;
}

.more-card {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
}

.more-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
}

.more-name {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  display: block;
}

.more-meta {
  display: flex;
  justify-content: space-between;
  padding-left: 16rpx;
}

.more-cat {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.more-stats {
  font-size: 26rpx;
  color: var(--text-muted);
}

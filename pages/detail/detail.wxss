/* pages/detail/detail.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFE8E8 100%);
  padding-bottom: 120rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  pointer-events: none;
  z-index: 0;
}

.deco-shape {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.shape-1 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #FF6B6B, #FFE66D);
  top: -100rpx;
  right: -100rpx;
}

.shape-2 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #4ECDC4, #44AF69);
  bottom: 200rpx;
  left: -80rpx;
}

.shape-3 {
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, #FFE66D, #FF6B6B);
  top: 50%;
  right: -50rpx;
}

/* 内容卡片 */
.content-card {
  position: relative;
  z-index: 1;
  margin: 32rpx 24rpx;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(255, 107, 107, 0.12);
}

.category-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.joke-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 32rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 107, 107, 0.3), transparent);
}

.divider-icon {
  font-size: 32rpx;
  margin: 0 24rpx;
}

.joke-content {
  font-size: 32rpx;
  color: #444444;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}

.joke-meta {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 107, 107, 0.1);
  gap: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
}

.meta-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #999999;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  padding: 0 24rpx;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.15);
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.like-btn.liked {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.like-btn.liked .btn-text {
  color: #FFFFFF;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 更多推荐 */
.more-section {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
  padding: 0 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.more-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.more-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.08);
  transition: all 0.3s ease;
}

.more-card:active {
  transform: scale(0.98);
}

.more-category {
  display: inline-block;
  font-size: 20rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.more-title {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more-likes {
  display: flex;
  align-items: center;
}

.heart-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.likes-num {
  font-size: 22rpx;
  color: #999999;
}
/* detail.wxss */

.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.nav-bar {
  padding: calc(16rpx + var(--safe-top)) 28rpx 28rpx;
  display: flex;
  justify-content: space-between;
}

.back-btn, .theme-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 14rpx;
  height: 2rpx;
  background: var(--text-secondary);
  position: relative;
}

.back-arrow::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-left: 2rpx solid var(--text-secondary);
  border-bottom: 2rpx solid var(--text-secondary);
  transform: rotate(45deg);
  position: absolute;
  left: 2rpx;
  top: -5rpx;
}

.theme-icon {
  font-size: 20rpx;
}

.main-card {
  margin: 28rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}

.color-bar {
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 10rpx;
}

.meta-cat {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.meta-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(240,147,251,0.12);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.main-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.image-area {
  margin-bottom: 20rpx;
}

.joke-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.main-content {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  white-space: pre-wrap;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.action-bar {
  display: flex;
  padding: 16rpx 28rpx;
  gap: 10rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
}

.action-btn.liked {
  background: rgba(240,147,251,0.12);
  border: none;
}

.action-btn.disliked {
  background: rgba(255,100,100,0.12);
  border: none;
}

.action-icon {
  font-size: 28rpx;
}

.action-num {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.action-btn.liked .action-num,
.action-btn.disliked .action-num {
  color: var(--text);
}

.more-area {
  padding: 28rpx;
}

.more-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.more-bar {
  width: 4rpx;
  height: 18rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.more-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.more-grid {
  display: flex;
  gap: 12rpx;
}

.more-card {
  width: calc(50% - 6rpx);
  padding: 16rpx;
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
}

.more-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
}

.more-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  padding-left: 12rpx;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.more-meta {
  display: flex;
  justify-content: space-between;
  padding-left: 12rpx;
}

.more-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

.more-stats {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 120rpx;
  position: relative;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  pointer-events: none;
}

/* 主卡片 */
.main-card {
  position: relative;
  margin: 24rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.card-top-bar {
  height: 8rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.card-category {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.card-hot {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.pulse-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.hot-text {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  padding: 0 24rpx 24rpx;
  display: block;
}

.card-content {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  padding: 0 24rpx;
  display: block;
  white-space: pre-wrap;
}

.card-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  padding: 24rpx;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.btn-fill {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.btn-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 1rpx solid;
}

.btn-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  position: relative;
  z-index: 1;
}

.action-btn.liked .btn-label {
  color: var(--text);
}

/* 更多推荐 */
.more-section {
  padding: 32rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-line {
  width: 4rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.more-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.more-card {
  width: calc(50% - 6rpx);
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 20rpx;
  position: relative;
  overflow: hidden;
}

.more-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
}

.more-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  display: block;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.more-likes {
  font-size: 22rpx;
  color: var(--text-muted);
  padding-left: 8rpx;
}

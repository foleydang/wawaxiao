.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.safe-area-top {
  height: var(--safe-top);
}

/* 导航 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.back-btn {
  width: 40rpx;
  height: 40rpx;
  background: var(--card);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.back-arrow {
  width: 12rpx;
  height: 2rpx;
  background: var(--text-secondary);
  position: relative;
}

.back-arrow::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-left: 2rpx solid var(--text-secondary);
  border-bottom: 2rpx solid var(--text-secondary);
  transform: rotate(45deg);
  position: absolute;
  left: 0;
  top: -4rpx;
}

.nav-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

/* 主卡片 */
.main-card {
  margin: 24rpx;
  padding: 20rpx;
}

.color-bar {
  height: 4rpx;
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.meta-category {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.meta-badge {
  font-size: 20rpx;
  color: var(--accent);
  margin-left: 12rpx;
  letter-spacing: 1rpx;
}

.meta-badge.seen {
  color: var(--text-muted);
}

.main-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
  display: block;
}

.content-scroll {
  max-height: 400rpx;
}

.main-content {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 操作 */
.action-row {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: var(--card);
  border: 1rpx solid var(--border);
}

.action-btn.liked {
  border: none;
}

.action-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.action-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.action-btn.liked .action-text {
  color: var(--text);
  font-weight: 500;
}

/* 更多 */
.more-section {
  padding: 24rpx;
}

.more-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.more-bar {
  width: 4rpx;
  height: 20rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.more-title {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.more-grid {
  display: flex;
  gap: 12rpx;
}

.more-card {
  width: calc(50% - 6rpx);
  padding: 16rpx;
  position: relative;
  overflow: hidden;
}

.more-color {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
}

.more-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 8rpx;
  padding-left: 12rpx;
  display: block;
}

.more-meta {
  display: flex;
  align-items: center;
  padding-left: 12rpx;
}

.more-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.more-cat {
  font-size: 22rpx;
  color: var(--text-muted);
}

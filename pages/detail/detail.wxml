<view class="page {{currentTheme}}">
  <scroll-view class="main-scroll" scroll-y show-scrollbar="{{false}}">
    <!-- 导航 -->
    <view class="nav-bar">
      <view class="back-btn glass" bindtap="goBack">
        <view class="back-arrow"></view>
      </view>
      <view class="theme-btn glass" bindtap="toggleTheme">
        <text class="theme-icon">{{themeIcon}}</text>
      </view>
    </view>

    <!-- 主卡片 -->
    <view class="main-card glass">
      <view class="color-bar" style="background: {{joke.color}}"></view>
      
      <view class="meta-row">
        <view class="meta-dot" style="background: {{joke.color}}"></view>
        <text class="meta-category">{{joke.category}}</text>
        <view class="meta-badge hot" wx:if="{{joke.isHot}}">HOT</view>
        <view class="meta-badge seen" wx:if="{{hasSeen}}">已看过</view>
        <view class="meta-badge image" wx:if="{{joke.images}}">🖼️ 图</view>
      </view>

      <text class="main-title">{{joke.title}}</text>

      <!-- 图片区域 -->
      <view class="image-section" wx:if="{{joke.images && joke.images.length > 0}}">
        <image 
          class="joke-image"
          wx:for="{{joke.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="widthFix"
          bindtap="previewImage"
          data-url="{{item}}"
          data-urls="{{joke.images}}"
        />
      </view>

      <!-- 文字内容 -->
      <scroll-view class="content-scroll" scroll-y>
        <text class="main-content">{{joke.content}}</text>
      </scroll-view>

      <!-- 统计 -->
      <view class="stats-row">
        <view class="stat">
          <text class="stat-value">{{joke.likes}}</text>
          <text class="stat-label">喜欢</text>
        </view>
        <view class="stat">
          <text class="stat-value">{{joke.dislikes}}</text>
          <text class="stat-label">不喜欢</text>
        </view>
        <view class="stat">
          <text class="stat-value">{{joke.shares || 0}}</text>
          <text class="stat-label">分享</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-row">
      <view class="action-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
        <view class="action-bg gradient-btn" wx:if="{{liked}}"></view>
        <text class="action-icon">{{liked ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{joke.likes}}</text>
      </view>
      
      <view class="action-btn {{disliked ? 'disliked' : ''}}" bindtap="toggleDislike">
        <view class="action-bg dislike-bg" wx:if="{{disliked}}"></view>
        <text class="action-icon">{{disliked ? '👎' : '👎🏻'}}</text>
        <text class="action-text">{{joke.dislikes}}</text>
      </view>
      
      <view class="action-btn" bindtap="shareJoke">
        <text class="action-icon">📤</text>
        <text class="action-text">{{joke.shares || 0}}</text>
      </view>
    </view>

    <!-- 更多推荐 -->
    <view class="more-section" wx:if="{{moreJokes.length > 0}}">
      <view class="more-header">
        <view class="more-bar"></view>
        <text class="more-title">再看点别的</text>
      </view>
      
      <view class="more-grid">
        <view 
          class="more-card glass"
          wx:for="{{moreJokes}}"
          wx:key="id"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <view class="more-color" style="background: {{item.color}}"></view>
          <text class="more-name">{{item.title}}</text>
          <view class="more-meta">
            <text class="more-cat">{{item.category}}</text>
            <text class="more-image" wx:if="{{item.hasImage}}">🖼️</text>
            <text class="more-likes">{{item.likes}}/{{item.dislikes}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

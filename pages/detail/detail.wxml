<view class="container">
  <!-- 背景装饰 -->
  <view class="bg-shapes">
    <view class="shape shape-1"></view>
    <view class="shape shape-2"></view>
  </view>

  <!-- 主卡片 -->
  <view class="main-card fade-in">
    <!-- 顶部区域 -->
    <view class="card-header">
      <view class="category-badge">
        <text class="badge-icon">{{joke.category === '职场' ? '💼' : joke.category === '生活' ? '🌈' : joke.category === '家庭' ? '🏠' : '📚'}}</text>
        <text class="badge-text">{{joke.category}}</text>
      </view>
      <view class="hot-badge" wx:if="{{joke.isHot}}">🔥 热门</view>
    </view>

    <!-- 标题 -->
    <text class="joke-title">{{joke.title}}</text>

    <!-- 分割线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-dot">😄</text>
      <view class="divider-line"></view>
    </view>

    <!-- 内容 -->
    <text class="joke-content">{{joke.content}}</text>

    <!-- 底部统计 -->
    <view class="joke-stats">
      <view class="stat-item">
        <text class="stat-icon">❤️</text>
        <text class="stat-value">{{joke.likes}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">📅</text>
        <text class="stat-value">{{formatDate(joke.createdAt)}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="action-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
      <view class="btn-bg" wx:if="{{!liked}}"></view>
      <view class="btn-gradient" wx:if="{{liked}}"></view>
      <text class="btn-icon">{{liked ? '❤️' : '🤍'}}</text>
      <text class="btn-text">{{liked ? '已喜欢' : '喜欢'}}</text>
    </view>
    
    <view class="action-btn share" bindtap="shareJoke">
      <view class="btn-bg"></view>
      <text class="btn-icon">📤</text>
      <text class="btn-text">分享</text>
    </view>
  </view>

  <!-- 更多推荐 -->
  <view class="more-section">
    <view class="section-header">
      <text class="section-icon">✨</text>
      <text class="section-title">更多笑话</text>
    </view>
    
    <view class="more-grid">
      <view 
        class="more-card"
        wx:for="{{moreJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="more-emoji">{{item.category === '职场' ? '💼' : item.category === '生活' ? '🌈' : item.category === '家庭' ? '🏠' : '📚'}}</view>
        <text class="more-title">{{item.title}}</text>
        <view class="more-likes">
          <text class="heart">❤️</text>
          <text class="num">{{item.likes}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

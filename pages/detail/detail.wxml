<view class="page {{currentTheme}}">
  <scroll-view class="main-scroll" scroll-y show-scrollbar="{{false}}">
    <!-- 导航：返回 + 主题 -->
    <view class="nav-bar">
      <view class="back-btn glass" bindtap="goBack">
        <view class="back-arrow"></view>
      </view>
      <view class="theme-btn glass" bindtap="toggleTheme">
        <text class="theme-icon">{{themeIcon}}</text>
      </view>
    </view>

    <!-- 主卡片 -->
    <view class="main-card glass">
      <view class="color-bar" style="background: {{joke.color}}"></view>
      
      <view class="meta-row">
        <view class="meta-dot" style="background: {{joke.color}}"></view>
        <text class="meta-cat">{{joke.category}}</text>
        <view class="meta-badge" wx:if="{{joke.isHot}}">HOT</view>
        <view class="meta-badge" wx:if="{{joke.hasImage}}">图</view>
      </view>

      <text class="main-title">{{joke.title}}</text>

      <!-- 图片 -->
      <view class="image-area" wx:if="{{joke.hasImage}}">
        <image 
          class="joke-img"
          wx:for="{{joke.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="widthFix"
          bindtap="previewImage"
          data-url="{{item}}"
        />
      </view>

      <!-- 内容 -->
      <text class="main-content">{{joke.content}}</text>

      <!-- 统计 -->
      <view class="stats-bar">
        <view class="stat">
          <text class="stat-num">{{joke.likes}}</text>
          <text class="stat-label">喜欢</text>
        </view>
        <view class="stat">
          <text class="stat-num">{{joke.dislikes}}</text>
          <text class="stat-label">不喜欢</text>
        </view>
        <view class="stat">
          <text class="stat-num">{{joke.shares}}</text>
          <text class="stat-label">分享</text>
        </view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="action-bar">
      <view class="action-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
        <text class="action-icon">{{liked ? '❤️' : '🤍'}}</text>
        <text class="action-num">{{joke.likes}}</text>
      </view>
      
      <view class="action-btn {{disliked ? 'disliked' : ''}}" bindtap="toggleDislike">
        <text class="action-icon">{{disliked ? '👎' : '👎🏻'}}</text>
        <text class="action-num">{{joke.dislikes}}</text>
      </view>
      
      <button class="action-btn" open-type="share" bindtap="onShare">
        <text class="action-icon">📤</text>
        <text class="action-num">{{joke.shares}}</text>
      </button>
    </view>

    <!-- 更多 -->
    <view class="more-area" wx:if="{{moreJokes.length > 0}}">
      <view class="more-head">
        <view class="more-bar"></view>
        <text class="more-title">再看点别的</text>
      </view>
      
      <view class="more-grid">
        <view 
          class="more-card glass"
          wx:for="{{moreJokes}}"
          wx:key="id"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <view class="more-color" style="background: {{item.color}}"></view>
          <text class="more-name">{{item.title}}</text>
          <view class="more-meta">
            <text class="more-cat">{{item.category}}</text>
            <text class="more-stats">{{item.likes}}{{item.hasImage ? '图' : ''}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

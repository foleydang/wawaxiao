<!--pages/detail/detail.wxml-->
<view class="container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="deco-shape shape-1"></view>
    <view class="deco-shape shape-2"></view>
    <view class="deco-shape shape-3"></view>
  </view>

  <!-- 内容卡片 -->
  <view class="content-card">
    <!-- 分类标签 -->
    <view class="category-tag">{{joke.category}}</view>
    
    <!-- 标题 -->
    <view class="joke-title">{{joke.title}}</view>
    
    <!-- 分割线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-icon">😄</text>
      <view class="divider-line"></view>
    </view>
    
    <!-- 内容 -->
    <view class="joke-content">{{joke.content}}</view>
    
    <!-- 底部信息 -->
    <view class="joke-meta">
      <view class="meta-item">
        <text class="meta-icon">❤️</text>
        <text class="meta-value">{{joke.likes}}</text>
      </view>
      <view class="meta-item" wx:if="{{joke.isHot}}">
        <text class="meta-icon">🔥</text>
        <text class="meta-value">热门</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="action-btn like-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
      <text class="btn-icon">{{liked ? '❤️' : '🤍'}}</text>
      <text class="btn-text">{{liked ? '已喜欢' : '喜欢'}}</text>
    </view>
    <view class="action-btn share-btn" bindtap="shareJoke">
      <text class="btn-icon">📤</text>
      <text class="btn-text">分享</text>
    </view>
  </view>

  <!-- 更多推荐 -->
  <view class="more-section">
    <view class="section-header">
      <text class="section-title">✨ 更多笑话</text>
    </view>
    <view class="more-list">
      <view 
        class="more-card" 
        wx:for="{{moreJokes}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="more-category">{{item.category}}</view>
        <view class="more-title">{{item.title}}</view>
        <view class="more-likes">
          <text class="heart-icon">❤️</text>
          <text class="likes-num">{{item.likes}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
<view class="page">
  <!-- 背景 -->
  <view class="page-bg" style="background: linear-gradient(180deg, {{joke.color}}22 0%, var(--bg) 40%)"></view>

  <!-- 主卡片 -->
  <view class="main-card scale-in">
    <!-- 顶部色条 -->
    <view class="card-top-bar" style="background: linear-gradient(90deg, {{joke.color}} 0%, {{joke.color}}88 100%)"></view>
    
    <!-- 分类标签 -->
    <view class="card-header">
      <text class="card-category" style="color: {{joke.color}}">{{joke.category}}</text>
      <view class="card-hot" wx:if="{{joke.isHot}}">
        <view class="pulse-dot" style="background: {{joke.color}}"></view>
        <text class="hot-text">HOT</text>
      </view>
    </view>

    <!-- 标题 -->
    <text class="card-title">{{joke.title}}</text>

    <!-- 内容 -->
    <text class="card-content">{{joke.content}}</text>

    <!-- 统计 -->
    <view class="card-stats">
      <view class="stat">
        <text class="stat-num">{{joke.likes}}</text>
        <text class="stat-label">LIKES</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{formatDate(joke.createdAt)}}</text>
        <text class="stat-label">DATE</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="action-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
      <view class="btn-fill" wx:if="{{liked}}" style="background: {{joke.color}}"></view>
      <view class="btn-border" style="border-color: {{joke.color}}"></view>
      <text class="btn-label">{{liked ? '已喜欢' : '喜欢'}}</text>
    </view>
    
    <view class="action-btn" bindtap="shareJoke">
      <view class="btn-border" style="border-color: var(--primary)"></view>
      <text class="btn-label">分享</text>
    </view>
  </view>

  <!-- 更多推荐 -->
  <view class="more-section">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">MORE</text>
    </view>
    
    <view class="more-grid">
      <view 
        class="more-card"
        wx:for="{{moreJokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="more-color" style="background: {{item.color}}"></view>
        <text class="more-title">{{item.title}}</text>
        <text class="more-likes">{{item.likes}}</text>
      </view>
    </view>
  </view>
</view>

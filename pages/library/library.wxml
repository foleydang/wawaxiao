<view class="page-wrapper {{pageClass}}">
  <!-- 顶部 -->
  <view class="header">
    <view class="search-bar glass btn-press" bindtap="goToSearch">
      <text class="search-icon">🔍</text>
      <text class="search-text">搜索笑话</text>
    </view>
    
    <view class="theme-btn glass btn-press" bindtap="toggleTheme">
      <text class="theme-icon">{{themeIcon}}</text>
    </view>
  </view>

  <!-- 分类 -->
  <scroll-view class="categories" scroll-x show-scrollbar="{{false}}">
    <view 
      class="cat-item {{currentCategory === item.name ? 'active' : ''}} btn-press"
      wx:for="{{categories}}"
      wx:key="name"
      bindtap="switchCategory"
      data-category="{{item.name}}"
    >
      <view class="cat-dot" style="background: {{item.color}}"></view>
      <text class="cat-name">{{item.name}}</text>
      <text class="cat-count">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="skeleton skeleton-card"></view>
    <view class="skeleton skeleton-card"></view>
    <view class="skeleton skeleton-card"></view>
  </view>

  <!-- 笑话列表 -->
  <view class="section" wx:if="{{!loading && jokes.length > 0}}">
    <view class="section-header">
      <view class="section-left">
        <view class="section-dot"></view>
        <text class="section-title">{{currentCategory === '全部' ? '全部笑话' : currentCategory}}</text>
      </view>
      <text class="section-count">{{jokes.length}}条</text>
    </view>

    <view class="joke-list">
      <view 
        class="joke-card glass fade-up btn-press"
        wx:for="{{jokes}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="joke-color" style="background: {{item.color}}"></view>
        <view class="joke-body">
          <text class="joke-title">{{item.title}}</text>
          <text class="joke-preview">{{item.preview}}</text>
        </view>
        <view class="joke-right">
          <text class="joke-likes">{{item.likes}}</text>
          <view class="joke-seen glass" wx:if="{{item.hasSeen}}">看过</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && jokes.length === 0}}">
    <view class="empty-icon glass">📝</view>
    <text class="empty-title">这个分类还没有笑话</text>
    <text class="empty-desc">换一个分类试试</text>
  </view>
</view>

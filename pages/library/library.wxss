/* library.wxss */

.page-wrapper {
  min-height: 100vh;
  padding-bottom: calc(40rpx + var(--safe-bottom));
  background: var(--bg);
  color: var(--text);
}

.page-wrapper.light-mode {
  background: #f8f9fa !important;
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .glass {
  background: rgba(0,0,0,0.04) !important;
  border-color: rgba(0,0,0,0.1) !important;
}

.page-wrapper.light-mode .section-title,
.page-wrapper.light-mode .cat-name,
.page-wrapper.light-mode .joke-title {
  color: #1a1a2e !important;
}

.page-wrapper.light-mode .search-text,
.page-wrapper.light-mode .section-count,
.page-wrapper.light-mode .joke-preview,
.page-wrapper.light-mode .joke-likes {
  color: #555555 !important;
}

.page-wrapper.light-mode .joke-seen {
  color: #888888 !important;
}

/* 顶部 */
.header {
  padding: calc(56rpx + var(--safe-top)) 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  margin-right: 12rpx;
}

.search-icon {
  font-size: 20rpx;
  margin-right: 12rpx;
}

.search-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.theme-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 20rpx;
}

/* 分类 */
.categories {
  padding: 8rpx 28rpx 24rpx;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 14rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  background: var(--card);
}

.cat-item.active {
  background: rgba(102,126,234,0.1);
}

.cat-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.cat-name {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.cat-item.active .cat-name {
  color: var(--text);
  font-weight: 500;
}

.cat-count {
  font-size: 24rpx;
  color: var(--accent);
  margin-left: 8rpx;
}

/* 板块 */
.section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 28rpx 16rpx;
}

.section-left {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 4rpx;
  height: 16rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
}

.section-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 笑话列表 */
.joke-list {
  padding: 8rpx 28rpx;
}

.joke-card {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.joke-card:active {
  opacity: 0.85;
}

.joke-color {
  width: 4rpx;
  min-height: 48rpx;
  border-radius: 2rpx;
  margin-right: 16rpx;
  align-self: stretch;
}

.joke-body {
  flex: 1;
  min-width: 0;
}

.joke-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.joke-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.joke-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 16rpx;
  align-self: center;
  gap: 6rpx;
}

.joke-likes {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.joke-seen {
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--bg-light);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
}

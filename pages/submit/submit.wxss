.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.header {
  padding: calc(56rpx + var(--safe-top)) 32rpx 40rpx;
}

.header-line {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 42rpx;
  font-weight: 600;
}

.header-desc {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.form {
  margin: 32rpx;
  padding: 28rpx;
}

.form-section {
  margin-bottom: 28rpx;
  position: relative;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.cat-grid {
  display: flex;
  gap: 12rpx;
}

.cat-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx;
  border-radius: 12rpx;
}

.cat-btn.active {
  background: rgba(102,126,234,0.15);
}

.cat-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.cat-name {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.cat-btn.active .cat-name {
  color: var(--text);
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 64rpx;
  padding: 14rpx 20rpx;
  font-size: 32rpx;
  color: var(--text);
  border-radius: 12rpx;
}

.form-count {
  position: absolute;
  right: 20rpx;
  top: 56rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.textarea-count {
  top: 180rpx;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 14rpx 20rpx;
  font-size: 32rpx;
  color: var(--text);
  border-radius: 12rpx;
}

.submit-section {
  padding: 32rpx;
}

.submit-btn {
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
}

.submit-btn:not(.disabled) {
  border: none;
}

.submit-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  box-shadow: 0 0 24rpx rgba(102,126,234,0.4);
}

.submit-text {
  font-size: 34rpx;
  font-weight: 500;
  position: relative;
  color: var(--text-muted);
}

.submit-btn:not(.disabled) .submit-text {
  color: var(--text);
}

.submit-tip {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 20rpx;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  width: 520rpx;
  padding: 48rpx;
  text-align: center;
}

.success-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}

.success-line {
  width: 32rpx;
  height: 4rpx;
  background: var(--text);
  border-radius: 2rpx;
  transform: rotate(45deg);
  position: relative;
}

.success-line::after {
  content: '';
  width: 16rpx;
  height: 4rpx;
  background: var(--text);
  position: absolute;
  left: -6rpx;
  top: 6rpx;
  transform: rotate(-90deg);
}

.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.success-btn {
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-btn-text {
  font-size: 32rpx;
  color: var(--text);
  font-weight: 500;
}

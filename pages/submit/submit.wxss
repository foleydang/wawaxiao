.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.header {
  padding: 48rpx 0 32rpx;
}

.header-line {
  width: 48rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  border-radius: 2rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.header-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.form {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  display: block;
}

.category-grid {
  display: flex;
  gap: 8rpx;
}

.category-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  gap: 8rpx;
}

.category-item.active {
  border-color: var(--primary);
}

.category-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.category-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.category-item.active .category-name {
  color: var(--text);
  font-weight: 500;
}

.input-wrap {
  position: relative;
}

.input {
  width: 100%;
  height: 72rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

.input-count {
  position: absolute;
  right: 16rpx;
  top: 20rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.textarea-wrap {
  position: relative;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

.textarea-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.submit-section {
  padding: 32rpx 0;
}

.submit-btn {
  height: 88rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: var(--bg);
  border: 1rpx solid var(--border);
}

.submit-btn:not(.disabled) {
  border: none;
}

.btn-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
}

.submit-text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
  color: var(--text-muted);
}

.submit-btn:not(.disabled) .submit-text {
  color: var(--text);
}

.submit-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 16rpx;
}

/* 成功弹窗 */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.success-overlay.show {
  opacity: 1;
  visibility: visible;
}

.success-modal {
  width: 520rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  text-align: center;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--success) 0%, #00f2fe 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.check-line {
  width: 32rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 3rpx;
  transform: rotate(45deg);
  position: relative;
}

.check-line::after {
  content: '';
  width: 16rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 3rpx;
  position: absolute;
  left: -8rpx;
  top: 8rpx;
  transform: rotate(-90deg);
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}

.success-btn {
  height: 72rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-btn .btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 2rpx;
}

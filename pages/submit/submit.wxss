.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.header {
  padding: calc(48rpx + var(--safe-top)) 24rpx 24rpx;
}

.header-line {
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  border-radius: 2rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.form {
  margin: 24rpx;
  padding: 24rpx;
}

.form-section {
  margin-bottom: 24rpx;
  position: relative;
}

.form-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-muted);
  margin-bottom: 12rpx;
  display: block;
}

.cat-grid {
  display: flex;
  gap: 8rpx;
}

.cat-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
}

.cat-btn.active {
  border-color: rgba(102,126,234,0.3);
  background: rgba(102,126,234,0.1);
}

.cat-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.cat-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.cat-btn.active .cat-name {
  color: var(--text);
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 56rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  color: var(--text);
}

.form-count {
  position: absolute;
  right: 16rpx;
  top: 44rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.textarea-count {
  top: 156rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  color: var(--text);
}

.submit-section {
  padding: 24rpx;
}

.submit-btn {
  height: 72rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: var(--bg-light);
  border: 1rpx solid var(--border);
}

.submit-btn:not(.disabled) {
  border: none;
}

.submit-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.submit-text {
  font-size: 30rpx;
  font-weight: 500;
  position: relative;
  color: var(--text-muted);
}

.submit-btn:not(.disabled) .submit-text {
  color: var(--text);
}

.submit-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 16rpx;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  width: 500rpx;
  padding: 40rpx;
  text-align: center;
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.success-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #43e97b, #00f2fe);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.success-line {
  width: 28rpx;
  height: 4rpx;
  background: var(--text);
  border-radius: 2rpx;
  transform: rotate(45deg);
  position: relative;
}

.success-line::after {
  content: '';
  width: 12rpx;
  height: 4rpx;
  background: var(--text);
  position: absolute;
  left: -6rpx;
  top: 6rpx;
  transform: rotate(-90deg);
}

.success-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.success-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 24rpx;
}

.success-btn {
  height: 64rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-btn-text {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

<view class="page">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-line"></view>
    <text class="header-title gradient-text">投稿</text>
    <text class="header-desc">分享你的笑话</text>
  </view>

  <!-- 表单 -->
  <view class="form">
    <!-- 分类 -->
    <view class="form-section">
      <text class="form-label">CATEGORY</text>
      <view class="category-grid">
        <view 
          class="category-item {{form.category === item.name ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="name"
          bindtap="selectCategory"
          data-category="{{item.name}}"
        >
          <view class="category-dot" style="background: {{item.color}}"></view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 标题 -->
    <view class="form-section">
      <text class="form-label">TITLE</text>
      <view class="input-wrap">
        <input class="input" placeholder="标题" maxlength="50" value="{{form.title}}" bindinput="inputTitle"/>
        <text class="input-count">{{form.title.length}}/50</text>
      </view>
    </view>

    <!-- 内容 -->
    <view class="form-section">
      <text class="form-label">CONTENT</text>
      <view class="textarea-wrap">
        <textarea class="textarea" placeholder="笑话内容..." maxlength="500" value="{{form.content}}" bindinput="inputContent"/>
        <text class="textarea-count">{{form.content.length}}/500</text>
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-section">
    <view class="submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="submitJoke">
      <view class="btn-bg" wx:if="{{canSubmit}}"></view>
      <text class="submit-text">{{canSubmit ? 'SUBMIT' : '请填写完整'}}</text>
    </view>
    <text class="submit-tip">提交后等待审核</text>
  </view>
</view>

<!-- 成功弹窗 -->
<view class="success-overlay {{showSuccess ? 'show' : ''}}" bindtap="hideSuccess">
  <view class="success-modal scale-in" catchtap="preventClose">
    <view class="success-icon">
      <view class="check-line"></view>
    </view>
    <text class="success-title">SUCCESS</text>
    <text class="success-desc">已提交，等待审核</text>
    <view class="success-btn gradient-btn" bindtap="hideSuccess">
      <text class="btn-text">继续投稿</text>
    </view>
  </view>
</view>
